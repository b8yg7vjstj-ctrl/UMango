<Project Sdk="Microsoft.NET.Sdk">

  <!--
    测试工程。

    · 目标框架**故意不在这里写**：由 src/Directory.Build.props 统一提供（net10.0-windows），
      EnableWindowsTargeting 也来自那个文件，所以 macOS 上可以直接交叉编译本工程。
    · 也**没有**设 UseWPF：被测的 PackageManagers / Records / Execution / Platform 全部与 WPF 无关，
      测试代码不引用任何 WPF 类型，因此编译不需要 WindowsDesktop 的引用程序集。
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      关键：关闭"传递框架引用"。

      历史与现状（注释曾经过期，这里更正）：
        · 原先 UMango.Core 标了 UseWPF=true（移植 PCL-CE TaskModel 时的残留），
          引用它就会把 Microsoft.WindowsDesktop.App 的框架引用传递过来，
          测试主机的 runtimeconfig 因此要求该运行时 —— 而它只存在于 Windows。
        · 现在 Core 已去掉 UseWPF，并改为多目标（net10.0 + net10.0-windows），
          因此**理论上这一行已不再必需**。
        · 但仍**刻意保留**：它是"测试主机不依赖任何 Windows 专有框架"的显式约束，
          将来若有工程重新引入 WPF 依赖，测试会立刻因宿主起不来而失败，
          而不是等到有人在 Windows 上跑才发现。
    -->
    <DisableTransitiveFrameworkReferences>true</DisableTransitiveFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- 版本均为较新的稳定版；除测试框架外不引入任何第三方依赖（不新增 NuGet 依赖是硬性要求） -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UMango.Core\UMango.Core.csproj" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    **刻意不设 UseWPF。**

    历史：本工程最初移植 PCL-CE 的 TaskModel 时用了 WPF 的 ObservableObject，因此标了 UseWPF=true。
    后来 TaskModel 已改用 CommunityToolkit.Mvvm 的 ObservableObject（不依赖 WPF），
    这个标记就成了残留 —— 而它的代价不小：
      · 引用本工程的任何工程（含测试工程）都会**传递**地对
        Microsoft.WindowsDesktop.App 提出框架引用，于是只能在 Windows 上运行；
      · 它把"Core 是否真的可跨平台"这件事变得无法验证。
    去掉后 Core 是一个纯粹的托管库，可在任何平台（含未来的 Avalonia 移植）直接复用。

    有一条测试守着这个决定：XamlAudit 之外，UMango.Core.Tests 与 UMango.App.Tests
    都能在 macOS 上跑 —— 若有人重新引入 WPF 依赖，测试会立刻失败。
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>

    <!--
      **多目标：net10.0 + net10.0-windows。**

      为什么要多这一个 net10.0：
        · 它是"Core 真的与平台无关"的**编译期证明** —— 不是靠声明，而是靠能编过；
        · 将来做 Avalonia 移植时，Avalonia 工程直接消费 net10.0 这一支；
        · 它能在编译期拦住"有人往 Core 里塞 Windows 专用 API"这类退化：
          一旦引入 System.Windows / Registry / DllImport(win32)，net10.0 这一支立刻编译失败，
          而不是等到跨平台重构时才发现。
      （注意：Directory.Build.props 里的 TargetFramework 单数是给 App/Tests 用的；
        这里用复数 TargetFrameworks，SDK 会优先按复数的多目标处理 Core。）
    -->
    <TargetFrameworks>net10.0;net10.0-windows</TargetFrameworks>

    <!--
      WinRT Toast 互操作（Utils/WinRT/ + UI/ToastNotification.cs）是原生 unsafe 代码
      （裸函数指针 vtable 调用）。这些文件**只参与 net10.0-windows 编译**
      （见下方 ItemGroup 的 Condition），因此这里只需为 windows 支打开 unsafe；
      net10.0 支保持纯净 —— 那正是"Core 真的与平台无关"的编译期证明。
    -->
    <AllowUnsafeBlocks Condition="'$(TargetFramework)' == 'net10.0-windows'">true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- 唯一依赖：MVVM 基础设施（ObservableObject / RelayCommand），跨平台 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
    <!--
      验证器族（Utils/Validate/，P1-7）：PCL-CE 用 FluentValidation 搭规则链。
      FluentValidation 12.1.1 = Apache-2.0（nuget .nuspec 的 license type="expression" 明示），
      零传递依赖，不引入任何传染性义务。
    -->
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!--
    DPAPI（ProtectedData）只对 net10.0-windows 支有意义。
    它在 Windows 桌面框架引用里是**转发**类型（实际住在
    System.Security.Cryptography.ProtectedData 程序集），而 Core 刻意不启用
    UseWPF/UseWindowsForms —— 库工程的 `net10.0-windows` TFM 本身并不隐含
    WindowsDesktop 框架引用，所以只能显式加这个包。
    版本 8.0.0 = MIT，零传递依赖。
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!--
    WinRT Toast 互操作只编进 net10.0-windows：它用的是 Windows 专属的 COM vtable
    （IToastNotifier / IXmlDocumentIO / HString 等），net10.0 支既没有对应的
    框架引用也不该有。排除而非 #if 的理由：这些文件里几乎每行都带指针类型，
    用预处理包起来会让"逐字采用"变成"逐字采用但已认不出来"。
  -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="UI/ToastNotification.cs" />
    <Compile Remove="Utils/WinRT/**/*.cs" />
    <!-- AumidHelper 只用 Microsoft.Win32 注册表，同样是 Windows-only -->
    <Compile Remove="Utils/OS/AumidHelper.cs" />
    <!-- DPAPI 密钥保护器（Windows-only）：net10.0 支用文件权限版 -->
    <Compile Remove="Security/Platform/WindowsDpapiKeyProtector.cs" />
    <Compile Remove="Security/Platform/Windows/**/*.cs" />
  </ItemGroup>

  <!--
    密钥保护器的平台分支：Windows 用 DPAPI，其它平台用文件系统权限。
    两个工厂文件同名同命名空间（KeyProtectorFactory.Default），
    按 TargetFramework 二选一编入 —— 这样调用方（SecretService）
    完全不用知道自己在哪个平台上。
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Remove="Security/Platform/NonWindowsKeyProtector.cs" />
    <Compile Remove="Security/Platform/Portable/**/*.cs" />
  </ItemGroup>

</Project>

<!--
  ============================================================================
  UMango 控件主题包：PCL 观感层
  ============================================================================
  这个文件是"界面像不像 PCL"的关键 —— 之前 Styles.xaml 只覆盖 4 种控件
  （Button / RadioButton / TextBlock / Border），而 PCL 有 20+ 种。
  缺少统一控件观感层，是界面"看起来不像 PCL"的根因。

  【重要：本文件不含 PCL-CE 的任何 XAML 代码】
  依据《PCL 存储库合理使用许可》与《合理使用指南》，我们**只提取设计数值**
  （颜色、尺寸、圆角、字号、内边距），控件模板与触发器全部自行实现。
  数值来源：PCL-CE 的 `Plain Craft Launcher 2/Application.xaml` 与
  `Controls/*.xaml`（实测提取，逐项对照）。

  【使用方式】
  App.xaml 先合并 Tokens.*.xaml（颜色/尺寸），再合并本文件。
  本文件只引用 {DynamicResource}，因此换主题时自动重取值。

  【PCL 的关键设计特征（实测数值）】
  · 圆角：按钮 3、输入框 3、列表项 3、复选框 2
  · 边框：1px，用 ColorBrush1（#343d4a）而非灰色 —— 这是 PCL 的标志性观感
  · 按钮填充：ColorBrushHalfWhite（#55ffffff），叠在彩色底上呈半透明白
  · 文字：13px，Foreground = ColorBrush1，TextTrimming = CharacterEllipsis
  · 列表项：高 42，内边距 3,1，选中时左侧 2px 强调条
  ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ==================== 通用：文字 ==================== -->
  <!--
    PCL 的全局 TextBlock 样式（Application.xaml:142）：
    13px + ColorBrush1 + CharacterEllipsis + SnapsToDevicePixels。
    三个 Setter 的作用：统一字号、统一前景、**长文本自动省略而不撑破布局**。
  -->
  <Style TargetType="TextBlock" x:Key="PclText">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
  </Style>

  <!-- 次级说明文字（12px 灰） -->
  <Style TargetType="TextBlock" x:Key="PclTextSecondary" BasedOn="{StaticResource PclText}">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource BrG3}"/>
  </Style>

  <!-- 弱化提示（11px 浅灰） -->
  <Style TargetType="TextBlock" x:Key="PclTextHint" BasedOn="{StaticResource PclText}">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{DynamicResource BrG4}"/>
  </Style>

  <!-- ==================== 按钮 ==================== -->
  <!--
    PCL 的 MyButton（Controls/MyButton.xaml 实测）：
    圆角 3、1px 边框（ColorBrush1）、填充 ColorBrushHalfWhite、字号 13。
    hover 时填充加深为 SemiWhite；按下时再深一档 —— 三态都是**叠加半透明白**，
    而不是换一套颜色，因此按钮在任何底色上都能保持一致的"浮起"感。
  -->
  <Style TargetType="Button" x:Key="PclButton">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="Background" Value="{DynamicResource BrHalfWhite}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrC1}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="12,4"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrSemiWhite}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrWhite}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 主操作按钮：强调色填充 + 白字（搜索/安装这类主动作） -->
  <Style TargetType="Button" x:Key="PclPrimaryButton" BasedOn="{StaticResource PclButton}">
    <Setter Property="Background" Value="{DynamicResource BrC3}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrWhite}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrC3}"/>
  </Style>

  <!-- 危险操作按钮（卸载/清空记录） -->
  <Style TargetType="Button" x:Key="PclDangerButton" BasedOn="{StaticResource PclButton}">
    <Setter Property="Foreground" Value="{DynamicResource BrError}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrError}"/>
  </Style>

  <!-- ==================== 输入框 ==================== -->
  <!--
    PCL 的 MyTextBox（Application.xaml:309）：
    圆角 3、1px ColorBrush1 边框、底色 SemiTransparent（几乎透明，露出页面底色）。
    聚焦时边框变为强调色 —— 这是 PCL 输入框最明显的交互反馈。
  -->
  <Style TargetType="TextBox" x:Key="PclTextBox">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource BrC1}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource BrC5}"/>
    <Setter Property="Background" Value="{DynamicResource BrSemiTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrC1}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrSemiWhite}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 复选框 ==================== -->
  <!--
    PCL 的 MyCheckBox（Controls/MyCheckBox.xaml 实测）：
    方框 18x18、圆角 2、选中时用强调色填充 + 白色对勾。
    PCL 刻意用**小圆角方框**而不是圆形 —— 这是它区别于 Win10/Win11 原生复选框的地方。
  -->
  <Style TargetType="CheckBox" x:Key="PclCheckBox">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="2"
                    BorderThickness="1" BorderBrush="{DynamicResource BrC1}"
                    Background="{DynamicResource BrSemiTransparent}"
                    VerticalAlignment="Center" SnapsToDevicePixels="True">
              <!-- 对勾用 Path 画，不依赖字体图标（字体缺失时不会变成豆腐块） -->
              <Path x:Name="Check" Visibility="Collapsed"
                    Data="M 3,8 L 7,12 L 14,4"
                    Stroke="{DynamicResource BrWhite}" StrokeThickness="2"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    StrokeLineJoin="Round"/>
            </Border>
            <ContentPresenter Margin="4,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrC3}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 下拉框 ==================== -->
  <!--
    PCL 的 MyComboBox（Application.xaml:423）：
    外观与 TextBox 一致（圆角 3 / 1px ColorBrush1 边框），
    右侧有一个小三角指示符。下拉列表项高 30、hover 用 ColorBrush6。
  -->
  <Style TargetType="ComboBox" x:Key="PclComboBox">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="Background" Value="{DynamicResource BrSemiTransparent}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrC1}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="6,3"/>
    <Setter Property="MinHeight" Value="24"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="PART_Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd"
                          Background="{DynamicResource BrSemiTransparent}"
                          BorderBrush="{DynamicResource BrC1}"
                          BorderThickness="1" CornerRadius="3"
                          SnapsToDevicePixels="True">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- 三角指示符：Path 绘制，不依赖字体 -->
                      <Path Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center"
                            Data="M 0,0 L 8,0 L 4,5 Z"
                            Fill="{DynamicResource BrG2}"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              Margin="8,0,24,0" VerticalAlignment="Center"/>

            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   PopupAnimation="Fade">
              <Border Background="{DynamicResource BrCard}"
                      BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                      CornerRadius="3" MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 下拉项：高 30、hover 用 ColorBrush6（浅蓝） -->
  <Style TargetType="ComboBoxItem" x:Key="PclComboBoxItem">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrC6}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrC7}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 列表项 ==================== -->
  <!--
    PCL 的 MyListItem（Controls/MyListItem.xaml 实测）：
    高 42、圆角 3、选中时左侧 2px 强调条 + ColorBrush6 底。
    注意 PCL 的列表项**不画边框**，只用底色区分 —— 画了边框会显得比 PCL 重。
  -->
  <Style TargetType="ListBoxItem" x:Key="PclListItem">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Grid Background="Transparent">
            <Border x:Name="Bd" Background="Transparent"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                VerticalAlignment="Center"/>
            </Border>
            <!-- 选中指示条：左侧 3px（与需求里的"左栏选中观感"一致） -->
            <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                    CornerRadius="2" Visibility="Collapsed"
                    Background="{DynamicResource BrC3}"
                    Margin="0,6" SnapsToDevicePixels="True"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrG8}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrC7}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 滚动条 ==================== -->
  <!--
    PCL 的 MyScrollBar（Application.xaml:172）：
    宽 8、圆角、thumb 用 ColorBrush4，轨道透明。
    PCL 的滚动条很细且低调 —— 这是它"干净"观感的重要来源。
  -->
  <Style TargetType="ScrollBar" x:Key="PclScrollBar">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Tb" Background="{DynamicResource BrG5}"
                              CornerRadius="4" Margin="1,0" SnapsToDevicePixels="True"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Tb" Property="Background" Value="{DynamicResource BrC4}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Tb" Property="Background" Value="{DynamicResource BrC3}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- 水平滚动条要反过来：宽高互换 -->
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Height" Value="8"/>
              <Setter Property="Width" Value="Auto"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 进度条 ==================== -->
  <!--
    PCL 的进度条：高 3~4、无边框、圆角、填充用强调色。
    刻意做得很细 —— PCL 的进度条是"信息"而非"装饰"。
  -->
  <Style TargetType="ProgressBar" x:Key="PclProgressBar">
    <Setter Property="Height" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource BrG6}"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC3}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="2"
                  SnapsToDevicePixels="True">
            <Grid ClipToBounds="True">
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                      Background="{TemplateBinding Foreground}" CornerRadius="2"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 滑块 ==================== -->
  <!--
    PCL 的滑块：轨道高 4 圆角、滑块 14x14 圆形。
    用圆形滑块是 PCL 有意的选择（与它方正的其他控件形成对比，让可拖动感更强）。
  -->
  <Style TargetType="Slider" x:Key="PclSlider">
    <Setter Property="Foreground" Value="{DynamicResource BrC3}"/>
    <Setter Property="Background" Value="{DynamicResource BrG6}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center" Height="20">
            <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                    Background="{TemplateBinding Background}" SnapsToDevicePixels="True"/>
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Border Height="4" CornerRadius="2" VerticalAlignment="Center"
                              Background="{DynamicResource BrC3}"/>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Opacity="0"/>
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="14" Height="14">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="Th" Fill="{DynamicResource BrC3}"
                               Stroke="{DynamicResource BrCard}" StrokeThickness="2"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Th" Property="Fill" Value="{DynamicResource BrC2}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 开关（ToggleButton） ==================== -->
  <!--
    PCL 用 ToggleButton 做"开关"外观（设置页的调试模式等）。
    尺寸 40x20、圆角 10、滑块 16 圆。
  -->
  <Style TargetType="ToggleButton" x:Key="PclSwitch">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Track" Width="40" Height="20" CornerRadius="10"
                    Background="{DynamicResource BrG5}" SnapsToDevicePixels="True">
              <Grid>
                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="{DynamicResource BrWhite}"
                         HorizontalAlignment="Left" Margin="2,0,0,0"/>
              </Grid>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource BrC3}"/>
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 单选按钮 ==================== -->
  <!--
    PCL 的 RadioButton：圆框 16x16、选中时内部实心圆点。
    用圆点而不是对勾，与 CheckBox 的方框形成区分。
  -->
  <Style TargetType="RadioButton" x:Key="PclRadioButton">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="16" Height="16" CornerRadius="8"
                    BorderThickness="1" BorderBrush="{DynamicResource BrC1}"
                    Background="{DynamicResource BrSemiTransparent}"
                    VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Ellipse x:Name="Dot" Width="8" Height="8" Visibility="Collapsed"
                       Fill="{DynamicResource BrWhite}"/>
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrC3}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
              <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ==================== 工具提示 ==================== -->
  <!--
    PCL 的 ToolTip：底色 ColorBrushToolTip（#e5ffffff，带透明度）、
    1px 灰边、圆角 3、字号 12。半透明底让它不遮挡背后的内容。
  -->
  <Style TargetType="ToolTip" x:Key="PclToolTip">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource BrToolTip}"
                  BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                  CornerRadius="3" Padding="8,5" MaxWidth="360"
                  SnapsToDevicePixels="True">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ========================================================================
       隐式默认样式层（关键）
       ========================================================================
       上面 17 个样式都带 x:Key，需要每个控件显式写 Style="{DynamicResource PclXxx}"
       才生效。实测 39 个控件里只有 3 个这么写了 —— 这就是"界面不像 PCL"的直接原因。

       这一层把 PCL 样式接成**控件类型的默认样式**（不带 x:Key 即隐式生效），
       于是所有 Button / TextBox / CheckBox… 自动获得 PCL 观感，
       无需逐个改页面。

       为什么不用 x:Key 覆盖而是 BasedOn 隐式样式：
       WPF 中同类型若同时存在隐式样式与显式样式，显式优先 ——
       所以页面里已经写了的显式样式仍能覆盖，不会打架。

       ⚠️ 注意：ScrollBar / ComboBoxItem / ToolTip 的隐式样式会作用到
       所有嵌套位置（例如 ComboBox 内部的 ScrollBar），这是期望行为 ——
       PCL 的观感本来就是全局一致的。
       ======================================================================== -->
  <Style TargetType="Button" BasedOn="{StaticResource PclButton}"/>
  <Style TargetType="TextBox" BasedOn="{StaticResource PclTextBox}"/>
  <Style TargetType="CheckBox" BasedOn="{StaticResource PclCheckBox}"/>
  <Style TargetType="ComboBox" BasedOn="{StaticResource PclComboBox}"/>
  <Style TargetType="ComboBoxItem" BasedOn="{StaticResource PclComboBoxItem}"/>
  <Style TargetType="ListBoxItem" BasedOn="{StaticResource PclListItem}"/>
  <Style TargetType="RadioButton" BasedOn="{StaticResource PclRadioButton}"/>
  <Style TargetType="ToggleButton" BasedOn="{StaticResource PclSwitch}"/>
  <Style TargetType="Slider" BasedOn="{StaticResource PclSlider}"/>
  <Style TargetType="ProgressBar" BasedOn="{StaticResource PclProgressBar}"/>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource PclScrollBar}"/>
  <Style TargetType="ToolTip" BasedOn="{StaticResource PclToolTip}"/>

</ResourceDictionary>

<!--
  PCL 设计 token（颜色/尺寸）。
  数值来自 PCL-CE 的 Application.xaml 资源字典（Apache-2.0），
  并用 PCL-CE 真实运行录屏逐像素校验过（详见 docs/DESIGN_PCL_CE.md）。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- 主色阶（蓝） -->
  <Color x:Key="C1">#343D4A</Color><Color x:Key="C2">#0B5BCB</Color>
  <Color x:Key="C3">#1370F3</Color><Color x:Key="C4">#4890F5</Color>
  <Color x:Key="C5">#96C0F9</Color><Color x:Key="C6">#D5E6FD</Color>
  <Color x:Key="C7">#E0EAFD</Color><Color x:Key="C8">#EAF2FE</Color>
  <!-- 灰阶 -->
  <Color x:Key="G1">#404040</Color><Color x:Key="G2">#737373</Color>
  <Color x:Key="G3">#8C8C8C</Color><Color x:Key="G4">#A6A6A6</Color>
  <Color x:Key="G5">#CCCCCC</Color><Color x:Key="G6">#EBEBEB</Color>
  <Color x:Key="G7">#F0F0F0</Color><Color x:Key="G8">#F5F5F5</Color>
  <!-- 语义色 -->
  <Color x:Key="RedLight">#FF4C4C</Color>
  <Color x:Key="RedBack">#FBDDDD</Color>
  <Color x:Key="Bg">#FBFBFB</Color>

  <SolidColorBrush x:Key="BrC1" Color="{StaticResource C1}"/>
  <SolidColorBrush x:Key="BrC2" Color="{StaticResource C2}"/>
  <SolidColorBrush x:Key="BrC3" Color="{StaticResource C3}"/>
  <SolidColorBrush x:Key="BrC5" Color="{StaticResource C5}"/>
  <SolidColorBrush x:Key="BrC6" Color="{StaticResource C6}"/>
  <SolidColorBrush x:Key="BrC8" Color="{StaticResource C8}"/>
  <SolidColorBrush x:Key="BrG1" Color="{StaticResource G1}"/>
  <SolidColorBrush x:Key="BrG2" Color="{StaticResource G2}"/>
  <SolidColorBrush x:Key="BrG3" Color="{StaticResource G3}"/>
  <SolidColorBrush x:Key="BrG4" Color="{StaticResource G4}"/>
  <SolidColorBrush x:Key="BrG5" Color="{StaticResource G5}"/>
  <SolidColorBrush x:Key="BrG6" Color="{StaticResource G6}"/>
  <SolidColorBrush x:Key="BrG8" Color="{StaticResource G8}"/>
  <SolidColorBrush x:Key="BrBg" Color="{StaticResource Bg}"/>
  <SolidColorBrush x:Key="BrRed" Color="{StaticResource RedLight}"/>

  <!-- 标题栏渐变：PCL 的标题栏实测为**纯色**（录屏横向 11 点采样 9 点同色），
       故这里用纯色而不是渐变。 -->
  <SolidColorBrush x:Key="BrTitleBar" Color="{StaticResource C3}"/>

  <!-- 尺寸（与 DESIGN_PCL_CE.md 一致） -->
  <sys:Double x:Key="TitleBarHeight">48</sys:Double>
  <sys:Double x:Key="LeftRailWidth">168</sys:Double>
  <sys:Double x:Key="WindowButtonWidth">46</sys:Double>
  <sys:Double x:Key="WindowButtonHeight">32</sys:Double>
  <sys:Double x:Key="TabHeight">27</sys:Double>
  <sys:Double x:Key="ListItemHeight">36</sys:Double>

  <!-- 字体回退链：不可用 PCL 自带字体，用系统字体 -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, PingFang SC, Helvetica Neue</FontFamily>
  <!-- Windows 原生窗口按钮字形（三大金刚键用系统图标字体，保证原生观感） -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>

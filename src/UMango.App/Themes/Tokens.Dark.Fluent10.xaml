<!--
  ============================================================================
  主题 token：Windows 10 Fluent · 深色（Tokens.Dark.Fluent10.xaml）
  ============================================================================
  沿用 Tokens.Light.Fluent10.xaml 的 key 名与几何，只做深色重映射。
  Win10 深色的真实观感：窗口底 #1F1F1F、内容/卡片 #2B2B2B、正文 #FFFFFF、次级文字 #C5C5C5、
  分隔线 #3A3A3A；标题栏仍跟随系统强调色（Win10 默认开启「在标题栏显示强调色」），
  因此 BrTitleBar 保持纯色强调蓝 —— 同时也满足「界面主要色相为蓝」的合规要求。

  注意：深色下"浅蓝底"必须反向变成"深蓝底"（C6/C7/C8），否则选中项会亮成手电筒；
  灰阶同 PCL 深色版一样反转：索引越大越暗（G8 是贴近窗口底的次级底）。
  ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ===== 主色阶（Win10 强调蓝一族）===== -->
  <Color x:Key="C1">#FFFFFF</Color>  <!-- 正文：Win10 深色下用纯白 -->
  <Color x:Key="C2">#005A9E</Color>
  <Color x:Key="C3">#0078D4</Color>  <!-- 主强调色：深色下 Win10 仍用同一强调蓝 -->
  <Color x:Key="C4">#2B88D8</Color>  <!-- 深底上悬停要提亮 -->
  <Color x:Key="C5">#4FA3E0</Color>  <!-- 次级进度条：深底上再亮一档才看得清 -->
  <Color x:Key="C6">#0E3C60</Color>  <!-- 选中底：强调蓝压暗后的深蓝 -->
  <Color x:Key="C7">#0A2C48</Color>
  <Color x:Key="C8">#17232F</Color>  <!-- 极暗蓝灰底（浅色版的 #F2F8FD 的深色对应物） -->
  <!-- ===== 灰阶 ===== -->
  <Color x:Key="G1">#C5C5C5</Color>
  <Color x:Key="G2">#A0A0A0</Color>
  <Color x:Key="G3">#8A8A8A</Color>
  <Color x:Key="G4">#6E6E6E</Color>
  <Color x:Key="G5">#4A4A4A</Color>
  <Color x:Key="G6">#3A3A3A</Color>  <!-- 分隔线与卡片边框 -->
  <Color x:Key="G7">#303030</Color>
  <Color x:Key="G8">#262626</Color>  <!-- 列表项悬停底（比窗口底 #1F1F1F 亮一档，符合 Win10 深色的轻微高亮） -->
  <!-- ===== 语义色 ===== -->
  <Color x:Key="RedLight">#FF6B6B</Color>
  <Color x:Key="RedBack">#45201F</Color>
  <Color x:Key="Bg">#1F1F1F</Color>

  <SolidColorBrush x:Key="BrC1" Color="{StaticResource C1}"/>
  <SolidColorBrush x:Key="BrC2" Color="{StaticResource C2}"/>
  <SolidColorBrush x:Key="BrC3" Color="{StaticResource C3}"/>
  <SolidColorBrush x:Key="BrC5" Color="{StaticResource C5}"/>
  <SolidColorBrush x:Key="BrC6" Color="{StaticResource C6}"/>
  <SolidColorBrush x:Key="BrC8" Color="{StaticResource C8}"/>
  <SolidColorBrush x:Key="BrG1" Color="{StaticResource G1}"/>
  <SolidColorBrush x:Key="BrG2" Color="{StaticResource G2}"/>
  <SolidColorBrush x:Key="BrG3" Color="{StaticResource G3}"/>
  <SolidColorBrush x:Key="BrG4" Color="{StaticResource G4}"/>
  <SolidColorBrush x:Key="BrG5" Color="{StaticResource G5}"/>
  <SolidColorBrush x:Key="BrG6" Color="{StaticResource G6}"/>
  <SolidColorBrush x:Key="BrG7" Color="{StaticResource G7}"/>
  <SolidColorBrush x:Key="BrG8" Color="{StaticResource G8}"/>
  <SolidColorBrush x:Key="BrBg" Color="{StaticResource Bg}"/>
  <SolidColorBrush x:Key="BrRed" Color="{StaticResource RedLight}"/>
  <!-- 语义色·警告 / 成功：深色版取同色相的亮化值（浅色版为 #8A5300 / #1E6B33），
       否则在深色卡片(#2B2B2B)上作为文字对比度不足。四套字典 key 名与数量必须一致。 -->
  <SolidColorBrush x:Key="BrWarnAmber" Color="#FFAD33"/>
  <!-- 琥珀底上的文字色：深色下琥珀是亮色，故角标文字取深色墨（= 窗口底色）。 -->
  <SolidColorBrush x:Key="BrWarnAmberFore" Color="#1F1F1F"/>
  <SolidColorBrush x:Key="BrProgressSuccess" Color="#61D180"/>

  <SolidColorBrush x:Key="BrTitleBar" Color="{StaticResource C3}"/>

  <!-- 扩展 token（key 与另三套完全同名） -->
  <SolidColorBrush x:Key="BrCard" Color="#2B2B2B"/>               <!-- Win10 深色内容区 -->
  <SolidColorBrush x:Key="BrTitleBarFore" Color="#B3FFFFFF"/>
  <SolidColorBrush x:Key="BrTitleBarForeHot" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrTitleBarHover" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="BrTitleBarBar" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrCaptionFore" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="BrCaptionHover" Color="#26FFFFFF"/>
  <SolidColorBrush x:Key="BrCaptionPressed" Color="#40FFFFFF"/>
  <SolidColorBrush x:Key="BrCaptionCloseHover" Color="#E81123"/>
  <SolidColorBrush x:Key="BrCaptionClosePressed" Color="#A4262C"/> <!-- 深色下按下态比悬停更沉 -->

  <!-- ===== 尺寸：与 Win10 Fluent 浅色版完全一致（几何不随深浅变化）===== -->
  <sys:Double x:Key="TitleBarHeight">32</sys:Double>
  <sys:Double x:Key="LeftRailWidth">200</sys:Double>
  <sys:Double x:Key="WindowButtonWidth">46</sys:Double>
  <sys:Double x:Key="WindowButtonHeight">32</sys:Double>
  <sys:Double x:Key="TabHeight">28</sys:Double>
  <sys:Double x:Key="ListItemHeight">32</sys:Double>

  <FontFamily x:Key="UiFont">Segoe UI, Microsoft YaHei UI, PingFang SC, Helvetica Neue</FontFamily>
  <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe Fluent Icons</FontFamily>
</ResourceDictionary>

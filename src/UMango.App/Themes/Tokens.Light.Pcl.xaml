<!--
  ============================================================================
  主题 token：PCL 经典 · 浅色（Tokens.Light.Pcl.xaml）
  ============================================================================
  数值来自 PCL-CE 的 Application.xaml 资源字典（Apache-2.0），
  并用 PCL-CE 真实运行录屏逐像素校验过（详见 docs/DESIGN_PCL_CE.md）。

  ⚠ 本文件是「PCL 经典浅色」的**权威定义**，数值与旧 PclTokens.xaml 一字不差
    （1:1 复刻的校验依据，任何取整/改色都会破坏复刻结论，故不要"顺手优化"数值）。

  命名契约：四套主题字典（Tokens.Light.Pcl / Tokens.Dark.Pcl /
  Tokens.Light.Fluent10 / Tokens.Dark.Fluent10）**key 名与 key 数量必须完全一致**，
  运行时切换主题只是整体替换字典，页面用 {DynamicResource Xxx} 引用才能跟着变。
  ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- ===== 主色阶（蓝）：C1 最深 → C8 最浅 ===== -->
  <Color x:Key="C1">#343D4A</Color><Color x:Key="C2">#0B5BCB</Color>
  <Color x:Key="C3">#1370F3</Color><Color x:Key="C4">#4890F5</Color>
  <Color x:Key="C5">#96C0F9</Color><Color x:Key="C6">#D5E6FD</Color>
  <Color x:Key="C7">#E0EAFD</Color><Color x:Key="C8">#EAF2FE</Color>
  <!-- ===== 灰阶：G1 最深（正文）→ G8 最浅（贴近窗口底色）===== -->
  <Color x:Key="G1">#404040</Color><Color x:Key="G2">#737373</Color>
  <Color x:Key="G3">#8C8C8C</Color><Color x:Key="G4">#A6A6A6</Color>
  <Color x:Key="G5">#CCCCCC</Color><Color x:Key="G6">#EBEBEB</Color>
  <Color x:Key="G7">#F0F0F0</Color><Color x:Key="G8">#F5F5F5</Color>
  <!-- ===== 语义色 ===== -->
  <Color x:Key="RedLight">#FF4C4C</Color>
  <Color x:Key="RedBack">#FBDDDD</Color>
  <Color x:Key="Bg">#FBFBFB</Color>

  <SolidColorBrush x:Key="BrC1" Color="{StaticResource C1}"/>
  <SolidColorBrush x:Key="BrC2" Color="{StaticResource C2}"/>
  <SolidColorBrush x:Key="BrC3" Color="{StaticResource C3}"/>
  <SolidColorBrush x:Key="BrC5" Color="{StaticResource C5}"/>
  <SolidColorBrush x:Key="BrC6" Color="{StaticResource C6}"/>
  <SolidColorBrush x:Key="BrC8" Color="{StaticResource C8}"/>
  <SolidColorBrush x:Key="BrG1" Color="{StaticResource G1}"/>
  <SolidColorBrush x:Key="BrG2" Color="{StaticResource G2}"/>
  <SolidColorBrush x:Key="BrG3" Color="{StaticResource G3}"/>
  <SolidColorBrush x:Key="BrG4" Color="{StaticResource G4}"/>
  <SolidColorBrush x:Key="BrG5" Color="{StaticResource G5}"/>
  <SolidColorBrush x:Key="BrG6" Color="{StaticResource G6}"/>
  <SolidColorBrush x:Key="BrG7" Color="{StaticResource G7}"/>
  <SolidColorBrush x:Key="BrG8" Color="{StaticResource G8}"/>
  <SolidColorBrush x:Key="BrBg" Color="{StaticResource Bg}"/>
  <SolidColorBrush x:Key="BrRed" Color="{StaticResource RedLight}"/>
  <!--
    语义色·警告（Degraded / 未验证）。取值 #8A5300 沿用需求指定的琥珀色，
    与旧实现（ui/lib/widgets/package_card.dart 的 AvailabilityState.degraded）一致。
    它原本是下载页里的页面级字面量；收敛进 token 的理由见 Themes/Styles.xaml 顶部：
    页面写死的颜色在深色主题下既改不动、也读不清。四套字典同名同数，故必须一起加。
  -->
  <SolidColorBrush x:Key="BrWarnAmber" Color="#8A5300"/>
  <!--
    琥珀底上的文字色（"未验证"/"GitHub Stars 兜底"两枚填充角标用）。
    为什么单独一个 key 而不是直接复用 BrTitleBarForeHot：深色主题把琥珀提亮成 #FFAD33 之后，
    白字压在上面只剩约 1.9:1 的对比度、几乎读不出来；角标底色与角标文字色必须能各自随主题变。
    浅色取值就是 #FFFFFF（与 BrTitleBarForeHot 相同），因此浅色观感与改造前完全一致。
  -->
  <SolidColorBrush x:Key="BrWarnAmberFore" Color="#FFFFFF"/>
  <!-- 语义色·成功（进度完成）。浅色取值 #1E6B33，同源于需求指定的"绿"（ReleaseChannel.stable）。 -->
  <SolidColorBrush x:Key="BrProgressSuccess" Color="#1E6B33"/>

  <!-- 标题栏：PCL 的标题栏实测为**纯色**（录屏横向 11 点采样 9 点同色），
       故这里用纯色而不是渐变。深色版同样保持 PCL 蓝，满足「主色相为蓝」的合规要求。 -->
  <SolidColorBrush x:Key="BrTitleBar" Color="{StaticResource C3}"/>

  <!--
    以下为四套主题**同名扩展 token**：原 PclTokens.xaml 没有这些 key，
    新增的目的是把 Styles.xaml 里原先硬编码的 White / #26FFFFFF / #C42B1C 等颜色
    全部收敛成 token —— 否则深色主题下标题栏、三大金刚键、卡片底色会"卡"在浅色值上。
    取值与原有硬编码值保持一致，因此浅色 PCL 主题的观感与改造前完全相同。
  -->
  <SolidColorBrush x:Key="BrCard" Color="#FFFFFF"/>              <!-- 卡片/内容区底色 -->
  <SolidColorBrush x:Key="BrTitleBarFore" Color="#B3FFFFFF"/>     <!-- 标题栏上未选中的选项卡文字 -->
  <SolidColorBrush x:Key="BrTitleBarForeHot" Color="#FFFFFF"/>    <!-- 标题栏上悬停/选中的文字 -->
  <SolidColorBrush x:Key="BrTitleBarHover" Color="#26FFFFFF"/>    <!-- 选项卡悬停/选中底色 -->
  <SolidColorBrush x:Key="BrTitleBarBar" Color="#FFFFFF"/>        <!-- 选项卡选中指示条 -->
  <SolidColorBrush x:Key="BrCaptionFore" Color="#FFFFFF"/>        <!-- 三大金刚键字形 -->
  <SolidColorBrush x:Key="BrCaptionHover" Color="#33FFFFFF"/>     <!-- 三大金刚键 hover -->
  <SolidColorBrush x:Key="BrCaptionPressed" Color="#55FFFFFF"/>   <!-- 三大金刚键 pressed -->
  <SolidColorBrush x:Key="BrCaptionCloseHover" Color="#C42B1C"/>   <!-- 关闭键 hover（Windows 原生红） -->
  <SolidColorBrush x:Key="BrCaptionClosePressed" Color="#A02316"/> <!-- 关闭键 pressed -->

  <!-- ===== 尺寸（与 DESIGN_PCL_CE.md 一致）===== -->
  <sys:Double x:Key="TitleBarHeight">48</sys:Double>
  <sys:Double x:Key="LeftRailWidth">168</sys:Double>
  <sys:Double x:Key="WindowButtonWidth">46</sys:Double>
  <sys:Double x:Key="WindowButtonHeight">32</sys:Double>
  <sys:Double x:Key="TabHeight">27</sys:Double>
  <sys:Double x:Key="ListItemHeight">36</sys:Double>

  <!-- 字体回退链：不可用 PCL 自带字体，用系统字体 -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Segoe UI, PingFang SC, Helvetica Neue</FontFamily>
  <!-- Windows 原生窗口按钮字形（三大金刚键用系统图标字体，保证原生观感） -->
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>

<!--
  ============================================================================
  控件样式（Themes/Styles.xaml）
  ============================================================================
  ⚠ 本文件里的**颜色/画刷/尺寸/字体一律用 {DynamicResource}，不要退回 {StaticResource}**。
    原因（WPF 主题切换最经典的坑）：StaticResource 在 XAML 加载时只求值一次并把结果
    写进属性，运行时把 Application.Resources.MergedDictionaries 里的 token 字典换成深色版，
    这些属性**不会**重新求值 —— 界面就"切不动主题"（换完还是浅色）。
    DynamicResource 建立的是运行时可重解析的引用，字典一换全部跟着变。
    唯一必须保留 StaticResource 的两处：
      · BasedOn="{StaticResource CaptionButton}" —— Style.BasedOn 不是依赖属性，不支持动态引用；
      · Converter={StaticResource BoolToVis}    —— Binding.Converter 也不是依赖属性，
        而且转换器实例由 App.xaml 提供、与主题无关。
  ============================================================================
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    顶部 banner 选项卡（主页/下载/设置/工具 四个）。
    高度取 TabHeight token：PCL 经典 27、Win10 Fluent 28，切换主题时自动跟随。
    选中态 = 白色文字 + 底部指示条；文字/底色/指示条三色全部走 token，深色主题同样成立。
  -->
  <Style x:Key="BannerTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource BrTitleBarFore}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Height="{DynamicResource TabHeight}" Margin="5,0">
            <Border x:Name="Bg" CornerRadius="4" Background="Transparent"/>
            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" Margin="10,0"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}"/>
            <!-- 选中指示条 -->
            <Border x:Name="Bar" Height="2" Width="20" CornerRadius="1"
                    Background="{DynamicResource BrTitleBarBar}"
                    VerticalAlignment="Bottom" Visibility="Collapsed"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BrTitleBarForeHot}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource BrTitleBarForeHot}"/>
              <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrTitleBarHover}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    三大金刚键：Windows 原生尺寸（46x32，PCL 与 Win10 都是这个规格，故取 WindowButton* token）。
    字形用系统图标字体（IconFont），hover/pressed 用半透明白叠加；
    关闭键的红色两套主题各自贴合自身观感（PCL 用 #C42B1C、Win10 用 #E81123）。
  -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="{DynamicResource WindowButtonWidth}"/>
    <Setter Property="Height" Value="{DynamicResource WindowButtonHeight}"/>
    <Setter Property="FontFamily" Value="{DynamicResource IconFont}"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="{DynamicResource BrCaptionFore}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrCaptionHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrCaptionPressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CaptionButtonClose" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrCaptionCloseHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrCaptionClosePressed}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    任务项模板：**父任务一行 + 子项各自一行进度**。
    这就是「下载进度界面按不同下载方式列明子项进度」的界面载体（进度页会用到，勿删）。
    卡片底色用 BrCard token：浅色 PCL 下为 #FFFFFF（与改造前硬编码的 White 完全一致），
    深色主题下自动变成深灰卡片，不会出现"白卡片糊在深色背景上"。
  -->
  <DataTemplate x:Key="TaskItemTemplate">
    <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="6"
            Background="{DynamicResource BrCard}"
            BorderBrush="{DynamicResource BrG6}" BorderThickness="1">
      <StackPanel>
        <!-- 父任务 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                     Foreground="{DynamicResource BrC1}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Grid.Column="1" Text="{Binding StateMessage}" FontSize="12"
                     Foreground="{DynamicResource BrG3}" Margin="10,0,0,0"/>
        </Grid>
        <ProgressBar Height="4" Margin="0,7,0,0" Minimum="0" Maximum="1"
                     Value="{Binding Progress}" Foreground="{DynamicResource BrC3}"
                     Background="{DynamicResource BrG6}" BorderThickness="0"
                     Visibility="{Binding SupportProgress, Converter={StaticResource BoolToVis}}"/>

        <!-- 子项：按下载方式/阶段各自一行进度 -->
        <ItemsControl ItemsSource="{Binding Children}" Margin="0,8,0,0"
                      Visibility="{Binding IsGroup, Converter={StaticResource BoolToVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                           Foreground="{DynamicResource BrG2}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <ProgressBar Grid.Column="1" Height="3" Margin="8,0" Minimum="0" Maximum="1"
                             Value="{Binding Progress}" Foreground="{DynamicResource BrC5}"
                             Background="{DynamicResource BrG6}" BorderThickness="0"
                             VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource BrG4}"
                           Text="{Binding StateMessage}" HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </DataTemplate>

  <!--
    通用卡片：各页面用它包内容块，避免每个页面自己写死底色/边框色。
    用法（页面里）：<Border Style="{DynamicResource PclCard}"> ... </Border>
    SnapsToDevicePixels 保证 1px 边框在 100%/125% DPI 下都是干净的实线，不被半像素糊掉。
  -->
  <Style x:Key="PclCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource BrCard}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrG6}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!--
    通用区块标题：14 号 SemiBold + BrC1（主文字色）。
    用法（页面里）：<TextBlock Style="{DynamicResource PclSectionTitle}" Text="包源状态"/>
  -->
  <Style x:Key="PclSectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
</ResourceDictionary>

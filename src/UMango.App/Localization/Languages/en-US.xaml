    <!-- ============ Settings ============ -->
    <sys:String x:Key="Settings.Title">Settings</sys:String>
    <sys:String x:Key="Settings.Subtitle">Theme &amp; appearance, debug mode, records</sys:String>
    <sys:String x:Key="Settings.Section.Appearance">Theme &amp; appearance</sys:String>
    <sys:String x:Key="Settings.Appearance.Hint">Theme changes apply immediately, no restart needed: all colors and fonts reference theme tokens (BrC1, BrG6, UiFont…) via DynamicResource, so replacing the token dictionary at runtime re-resolves every element.</sys:String>
    <sys:String x:Key="Settings.DarkMode">Dark mode</sys:String>
    <sys:String x:Key="Settings.DarkMode.Hint">Toggles dark mode on the current theme family (PCL Classic dark / Windows 10 Fluent dark) across every page in the window.</sys:String>
    <sys:String x:Key="Settings.Section.Animation">Animation</sys:String>
    <sys:String x:Key="Settings.Animation.Hint">The animation direction vector is switchable: UMango's own vector by default (deliberately mirrored from PCL-CE), or the exact PCL-CE feel. Applies immediately and persists.</sys:String>
    <sys:String x:Key="Settings.Animation.Enable">Enable animation</sys:String>
    <sys:String x:Key="Settings.Animation.DisableHint">When off, all animation durations become zero and elements land directly in their final state (no half-transparent or offset leftovers).</sys:String>
    <sys:String x:Key="Settings.Animation.Direction">Direction vector</sys:String>
    <sys:String x:Key="Settings.Section.Language">Language</sys:String>
    <sys:String x:Key="Settings.Language.Hint">UI language. Applies immediately and persists across restarts.</sys:String>
    <sys:String x:Key="Settings.Section.Debug">Debug</sys:String>
    <sys:String x:Key="Settings.DebugMode">Debug mode</sys:String>
    <sys:String x:Key="Settings.DebugMode.Hint">Keep the full terminal output and expand the inline terminal pane on the progress page (per step). When off, only the last few lines are kept to avoid slowing down rendering. This switch shares one TerminalBridge.DebugMode state with the progress page, so the two views always agree, and it persists across restarts.</sys:String>

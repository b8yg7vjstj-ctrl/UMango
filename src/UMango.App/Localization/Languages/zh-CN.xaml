<!--
  UMango 界面文本（简体中文）—— 兜底层，始终加载。

  分层模型（沿用 PCL-CE LocalizationService 的设计）：
    ① 本文件 = 兜底层，键最全，**始终**加载；
    ② 其它语言文件（如 en-US.xaml）= 叠加层，只写"变了的键"，重复键覆盖兜底层。
  好处：新增语言不必整包复制整份文本，只写差异。

  键名规范：Page/区域.元素.语义，例如 Home.Title = 主页大标题。
  XAML 侧用 {DynamicResource 键名} 引用（必须是 DynamicResource 才能在
  运行时切换语言后自动刷新；StaticResource 会在加载时定死）。
  代码侧经 PCL.Lang 桥（UMango.Core/Pcl/App/Localization/Lang.cs）读取。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ 通用 ============ -->
    <sys:String x:Key="Common.AppName">UMango</sys:String>
    <sys:String x:Key="Common.Action.Confirm">确定</sys:String>
    <sys:String x:Key="Common.Action.Cancel">取消</sys:String>
    <sys:String x:Key="Common.Action.Refresh">刷新</sys:String>
    <sys:String x:Key="Common.Action.Clear">清空显示</sys:String>
    <sys:String x:Key="Common.Action.Export">导出诊断包</sys:String>
    <sys:String x:Key="Common.Action.OpenFolder">打开日志目录</sys:String>
    <sys:String x:Key="Common.Dialog.Title">提示</sys:String>
    <sys:String x:Key="Common.Dialog.Warning">警告</sys:String>
    <sys:String x:Key="SystemDialog.Error.Title">错误</sys:String>

    <!-- ============ 左栏菜单 ============ -->
    <sys:String x:Key="Nav.Home">主页</sys:String>
    <sys:String x:Key="Nav.Download">下载</sys:String>
    <sys:String x:Key="Nav.Progress">进度</sys:String>
    <sys:String x:Key="Nav.Settings">设置</sys:String>
    <sys:String x:Key="Nav.Tools">工具</sys:String>

    <!-- ============ 主页 ============ -->
    <sys:String x:Key="Home.Title">UMango</sys:String>
    <sys:String x:Key="Home.Subtitle">跨平台包管理器图形界面</sys:String>
    <sys:String x:Key="Home.Section.System">系统信息</sys:String>
    <sys:String x:Key="Home.Section.Packages">包源状态</sys:String>
    <sys:String x:Key="Home.Section.Statistics">使用统计</sys:String>
    <sys:String x:Key="Home.Platform">当前平台</sys:String>
    <sys:String x:Key="Home.Architecture">处理器架构</sys:String>
    <sys:String x:Key="Home.RunningOn">运行在 {0}：</sys:String>
    <sys:String x:Key="Home.Column.Package">包源</sys:String>
    <sys:String x:Key="Home.Column.Directory">安装目录</sys:String>
    <sys:String x:Key="Home.Column.State">状态</sys:String>
    <sys:String x:Key="Home.ProbeDetail">探测明细</sys:String>
    <sys:String x:Key="Home.Statistics.Total">总次数</sys:String>
    <sys:String x:Key="Home.Statistics.Success">成功</sys:String>
    <sys:String x:Key="Home.Statistics.Failed">失败</sys:String>
    <sys:String x:Key="Home.Statistics.BySource">按包源次数</sys:String>
    <sys:String x:Key="Home.RecentOperations">最近操作</sys:String>
    <sys:String x:Key="Home.Yes">是</sys:String>
    <sys:String x:Key="Home.No">否</sys:String>
    <sys:String x:Key="Home.Platform.Windows">Windows</sys:String>
    <sys:String x:Key="Home.Platform.MacOS">macOS</sys:String>
    <sys:String x:Key="Home.Platform.Linux">Linux</sys:String>

    <!-- ============ 下载页 ============ -->
    <sys:String x:Key="Download.Title">下载</sys:String>
    <sys:String x:Key="Download.NewDownload">新建下载</sys:String>
    <sys:String x:Key="Download.SearchPlaceholder">搜索包名…</sys:String>
    <sys:String x:Key="Download.Engine">下载引擎</sys:String>
    <sys:String x:Key="Download.TerminalOutput">终端输出</sys:String>

    <!-- ============ 进度页 ============ -->
    <sys:String x:Key="Progress.Title">任务进度</sys:String>
    <sys:String x:Key="Progress.Empty">暂无任务，去下载页安装一个包试试</sys:String>
    <sys:String x:Key="Progress.SubProgress">子项进度</sys:String>
    <sys:String x:Key="Progress.State">状态</sys:String>
    <sys:String x:Key="Progress.State.Success">成功</sys:String>
    <sys:String x:Key="Progress.State.Failed">失败</sys:String>
    <sys:String x:Key="Progress.State.Running">进行中</sys:String>
    <sys:String x:Key="Progress.State.Waiting">等待中</sys:String>
    <sys:String x:Key="Progress.Processing">正在处理…</sys:String>

    <!-- ============ 设置页 ============ -->
    <sys:String x:Key="Settings.Title">设置</sys:String>
    <sys:String x:Key="Settings.Section.Appearance">主题与外观</sys:String>
    <sys:String x:Key="Settings.Section.Debug">调试模式</sys:String>
    <sys:String x:Key="Settings.Section.Records">管理记录</sys:String>
    <sys:String x:Key="Settings.Section.Language">语言</sys:String>
    <sys:String x:Key="Settings.Language.Hint">界面语言。切换后立即生效，下次启动保持。</sys:String>
    <sys:String x:Key="Settings.Language.FollowSystem">跟随系统</sys:String>
    <sys:String x:Key="Settings.DebugMode.Hint">开启后保留终端的完整输出，并在进度页把内联终端输出区展开显示（可按子项步骤查看每一步的全部日志）；关闭时只保留最近若干行，避免超长输出拖慢界面渲染。</sys:String>

    <!-- ============ 工具页 ============ -->
    <sys:String x:Key="Tools.Title">工具</sys:String>
    <sys:String x:Key="Tools.Diagnostics">系统诊断</sys:String>
    <sys:String x:Key="Tools.InstallDirectory">安装目录</sys:String>
    <sys:String x:Key="Tools.ProbeDetail">探测明细</sys:String>
    <sys:String x:Key="Tools.Report">诊断报告（可复制）</sys:String>

    <!-- ============ 日志页 ============ -->
    <sys:String x:Key="Log.Title">日志</sys:String>
    <sys:String x:Key="Log.AllLevels">全部</sys:String>
    <sys:String x:Key="Log.Level.Info">信息及以上</sys:String>
    <sys:String x:Key="Log.Level.Warn">警告及以上</sys:String>
    <sys:String x:Key="Log.Level.Error">仅错误</sys:String>
</ResourceDictionary>

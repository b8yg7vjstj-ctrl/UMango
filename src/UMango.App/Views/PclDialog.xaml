<Window x:Class="UMango.App.Views.PclDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="Height"
        Width="420" MaxHeight="520"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Caption}">
  <!--
    PCL 风格对话框。对照 PCL-CE 的 MyMsg 体系（PCL.Core/UI/MsgBoxWrapper.cs 契约）。
    颜色/圆角/边框全部走主题 token（{DynamicResource}），因此换主题即时生效；
    圆角 4、1px 细边、深灰文字 —— 与 Controls.Pcl.xaml 的控件观感一致。
  -->
  <Border Background="{DynamicResource BrCard}"
          BorderBrush="{DynamicResource BrG5}"
          BorderThickness="1" CornerRadius="4" Margin="12">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- 标题栏（可拖动） -->
      <Border x:Name="TitleBar" Grid.Row="0" Padding="14,10,14,6"
              Background="Transparent" MouseLeftButtonDown="OnTitleBarDrag">
        <StackPanel Orientation="Horizontal">
          <!-- 主题图标：颜色随 MsgBoxTheme 变化（Info 蓝 / Warning 琥珀 / Error 红） -->
          <Ellipse x:Name="ThemeDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                   Fill="{DynamicResource BrC3}"/>
          <TextBlock x:Name="CaptionText" Style="{DynamicResource PclText}"
                     FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- 正文（可滚动，长文本不撑破窗口） -->
      <ScrollViewer Grid.Row="1" MaxHeight="360" Padding="14,0,14,10"
                    VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="MessageText" Style="{DynamicResource PclText}"
                   TextWrapping="Wrap" LineHeight="19"/>
      </ScrollViewer>

      <!-- 按钮区（右下角，主按钮在右 —— 与 Windows/PCL 习惯一致） -->
      <StackPanel Grid.Row="2" Orientation="Horizontal"
                  HorizontalAlignment="Right" Margin="14,0,14,12"
                  x:Name="ButtonHost"/>
    </Grid>
  </Border>
</Window>

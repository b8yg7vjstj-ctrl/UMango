<!--
  ============================================================================
  设置页（Views/SettingsView.xaml）
  ============================================================================
  三张卡片：① 主题与外观 ② 调试 ③ 记录管理。

  ★ 颜色/字体/尺寸一律用 {DynamicResource Xxx} 引用主题 token，**不要退回 {StaticResource}**：
    WPF 的 StaticResource 在 XAML 加载时只求值一次并把结果写进属性，运行时 ThemeManager 把
    Application.Resources.MergedDictionaries 里的 token 字典整块换掉后，这些属性**不会**重新求值，
    主题就"切不动"（换完还是浅色）。本页的核心要求是"选中主题立刻看到效果"，
    因此页面里每一个颜色引用都必须是动态的。
    唯二必须保留 StaticResource 的地方（它们不是依赖属性，不支持动态引用）：
      · Style.BasedOn="{StaticResource PclActionButton}"（见 PclDangerButton）
      · Converter={StaticResource BoolToVis}（转换器实例由 App.xaml 提供，与主题无关）

  ★ 数据来源：
      · SettingsViewModel —— 主题选择、深色开关、调试模式、清空记录命令（主题的切换动作只在它里面发生）；
      · Core 的 InstallRecordStore —— 统计、按包源次数、记录明细。这些都在**视图侧**现取现填并
        由视图侧格式化（时间/操作名/耗时/错误码），这样 XAML 只需绑定字符串，
        不必新增枚举转换器文件，也不会出现"重新加载后明细新、数字旧"的不一致。
  ============================================================================
-->
<UserControl x:Class="UMango.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UMango.App.Views"
             xmlns:vm="clr-namespace:UMango.App.ViewModels"
             x:Name="PageRoot"
             FontFamily="{DynamicResource UiFont}"
             Background="Transparent"
             Loaded="SettingsView_Loaded" Unloaded="SettingsView_Unloaded"
             IsVisibleChanged="SettingsView_IsVisibleChanged">

  <UserControl.Resources>

    <!--
      主题选项卡容器（ListBoxItem）。自定义模板而不是用系统默认样式，理由有二：
        1) 默认模板的选中高亮是系统蓝底白字，与两套主题的观感都对不上，也无法跟随主题变色；
        2) 需求明确要求"关闭默认选中高亮"，改为「选中时用强调色描边 + 圆点」的卡片式选中态。
      选中态用 BrC3（两套主题的强调蓝）+ BrC8（强调色的极浅底），深色主题下同样成立。
    -->
    <Style x:Key="ThemeOptionItem" TargetType="ListBoxItem">
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" CornerRadius="4" Padding="10,9"
                    Background="{DynamicResource BrCard}"
                    BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- 单选圆点：未选中只有细圈，选中时圈变强调色并出现实心点 -->
                <Grid Grid.Column="0" Width="16" Height="16" VerticalAlignment="Center">
                  <Ellipse x:Name="Ring" Stroke="{DynamicResource BrG4}" StrokeThickness="1.5"
                           Fill="Transparent"/>
                  <Ellipse x:Name="Dot" Width="6" Height="6" Stretch="Fill"
                           Fill="{DynamicResource BrC3}" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrG8}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrC8}"/>
                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource BrC3}"/>
                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主题选项内容：标题 + 说明文字（说明文字用次级文字色 BrG3） -->
    <DataTemplate x:Key="ThemeOptionTemplate" DataType="vm:ThemeOption">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource BrC1}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Description}" FontSize="12" Margin="0,3,0,0"
                   Foreground="{DynamicResource BrG3}" TextWrapping="Wrap"/>
      </StackPanel>
    </DataTemplate>

    <!--
      自绘开关/复选框。不用系统默认 CheckBox 的原因：默认模板的方框取自系统颜色，
      深色主题下会变成"浅色方块糊在深色卡片上"，且不跟随主题切换。
      这里用 token 画方框（BrCard 底 + BrG5 边），选中态用强调蓝描边 + 强调色对勾。
    -->
    <Style x:Key="PclSwitch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource BrG1}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                      Background="{DynamicResource BrCard}"
                      BorderBrush="{DynamicResource BrG5}" BorderThickness="1"
                      VerticalAlignment="Center" SnapsToDevicePixels="True">
                <!-- 对勾字形用 U+2713，字体回退链里的系统字体都有，不依赖 PCL 图片资源 -->
                <TextBlock x:Name="Check" Text="&#x2713;" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource BrC3}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrC3}"/>
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrC8}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrC5}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 普通操作按钮（重新加载等）：底色/边框/文字全部走 token -->
    <Style x:Key="PclActionButton" TargetType="Button">
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrG5}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="4" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrG8}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrG7}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      危险操作按钮（清空记录）：沿用同一套模板，只把文字与边框换成语义红 BrRed。
      BasedOn 必须用 StaticResource —— Style.BasedOn 不是依赖属性，DynamicResource 在这里无效。
    -->
    <Style x:Key="PclDangerButton" TargetType="Button" BasedOn="{StaticResource PclActionButton}">
      <Setter Property="Foreground" Value="{DynamicResource BrRed}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BrRed}"/>
    </Style>

    <!-- 统计数字（总次数/成功/失败） -->
    <Style x:Key="StatNumber" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
    </Style>

    <Style x:Key="StatCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
      <Setter Property="Foreground" Value="{DynamicResource BrG3}"/>
    </Style>

    <Style x:Key="ColumnCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource BrG3}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- 记录列表的一行：时间 / 包源 / 包名 / 操作 / 结果 / 耗时（失败时结果下方显示错误码） -->
    <DataTemplate x:Key="RecordRowTemplate" DataType="views:RecordItem">
      <Border Padding="0,6" BorderBrush="{DynamicResource BrG7}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="70"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0" Text="{Binding Time}" FontSize="12"
                     Foreground="{DynamicResource BrG2}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12"
                     Foreground="{DynamicResource BrG1}" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
          <StackPanel Grid.Column="2" Margin="6,0,10,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Package}" FontSize="12" Foreground="{DynamicResource BrC1}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Version}" FontSize="11" Foreground="{DynamicResource BrG4}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasVersion, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <TextBlock Grid.Column="3" Text="{Binding Action}" FontSize="12"
                     Foreground="{DynamicResource BrG2}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="4" VerticalAlignment="Center">
            <TextBlock Text="{Binding ResultText}" FontSize="12" FontWeight="SemiBold">
              <TextBlock.Style>
                <!-- 失败用语义红、成功用强调色：两套主题下都成立，且不写死颜色 -->
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource BrRed}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Success}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource BrC3}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <!-- 失败记录必须把 ErrorCode 显示出来（只有真的取到错误码时才占位） -->
            <TextBlock Text="{Binding ErrorText}" FontSize="11" Margin="0,1,0,0"
                       Foreground="{DynamicResource BrRed}" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"/>
          </StackPanel>
          <TextBlock Grid.Column="5" Text="{Binding Duration}" FontSize="12"
                     Foreground="{DynamicResource BrG2}"
                     HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- 按包源次数的一行：包源名 + 等比条形 + 次数 -->
    <DataTemplate x:Key="SourceCountRowTemplate" DataType="views:SourceCountItem">
      <Grid Margin="0,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="96"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="70"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{Binding Source}" FontSize="12"
                   Foreground="{DynamicResource BrG1}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <Border Grid.Column="1" Height="6" CornerRadius="3" HorizontalAlignment="Left"
                Background="{DynamicResource BrC5}" Width="{Binding BarWidth}"
                VerticalAlignment="Center"/>
        <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="12"
                   Foreground="{DynamicResource BrG2}"
                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
      </Grid>
    </DataTemplate>

  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20,18,20,24">

      <!-- 页面标题 + 操作反馈（应用主题/清空/重新加载的结果都显示在这一行） -->
      <TextBlock Text="{DynamicResource Settings.Title}" FontSize="16" FontWeight="Bold"
                 Foreground="{DynamicResource BrC1}"/>
      <TextBlock Text="{DynamicResource Settings.Subtitle}" FontSize="12" Margin="0,4,0,0"
                 Foreground="{DynamicResource BrG3}"/>
      <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" FontSize="12"
                 Foreground="{DynamicResource BrC2}" TextWrapping="Wrap" Margin="0,8,0,0">
        <TextBlock.Style>
          <!-- StatusMessage 为 null（还没有任何操作）时整行收起，避免占一条空行 -->
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <!-- ==================== ① 主题与外观 ==================== -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,14,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Settings.Section.Appearance}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Appearance.Hint}"/>

          <!-- 主题族：选中即应用（TwoWay 绑定 ViewModel.SelectedTheme + SelectionChanged 触发 Apply） -->
          <ListBox x:Name="ThemeList" Margin="0,10,0,0"
                   ItemsSource="{Binding Themes}"
                   SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                   SelectionChanged="ThemeList_SelectionChanged"
                   ItemContainerStyle="{DynamicResource ThemeOptionItem}"
                   ItemTemplate="{DynamicResource ThemeOptionTemplate}"
                   Background="Transparent" BorderThickness="0" Padding="0"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

          <!-- 深色模式：与主题族组合成「PCL 经典/Windows10 Fluent × 浅色/深色」四种组合 -->
          <Border Margin="0,4,0,0" Padding="10,9" CornerRadius="4"
                  Background="{DynamicResource BrCard}"
                  BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                  SnapsToDevicePixels="True">
            <StackPanel>
              <CheckBox x:Name="DarkToggle" Style="{DynamicResource PclSwitch}"
                        Content="{DynamicResource Settings.DarkMode}" IsChecked="{Binding IsDark, Mode=TwoWay}"
                        Click="DarkToggle_Click"/>
              <TextBlock FontSize="12" Margin="25,4,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrG3}"
                         Text="{DynamicResource Settings.DarkMode.Hint}"/>

              <!-- 跟随系统：勾上后深浅色由操作系统决定，手动开关失效 -->
              <CheckBox x:Name="FollowSystemToggle" Style="{DynamicResource PclSwitch}"
                        Margin="0,8,0,0"
                        Content="{DynamicResource Settings.FollowSystem}" IsChecked="{Binding FollowSystem, Mode=TwoWay}"
                        Click="FollowSystemToggle_Click"/>
              <TextBlock FontSize="12" Margin="25,4,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrG3}"
                         Text="{DynamicResource Settings.FollowSystem.Hint}"/>
            </StackPanel>
          </Border>

          <!-- 灰度（哀悼日）模式：与深浅色正交，四种主题组合 × 灰度开关 = 八种观感 -->
          <Border Margin="0,4,0,0" Padding="10,9" CornerRadius="4"
                  Background="{DynamicResource BrCard}"
                  BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                  SnapsToDevicePixels="True">
            <StackPanel>
              <CheckBox x:Name="GrayToggle" Style="{DynamicResource PclSwitch}"
                        Content="{DynamicResource Settings.GrayMode}" IsChecked="{Binding GrayMode, Mode=TwoWay}"
                        Click="GrayToggle_Click"/>
              <TextBlock FontSize="12" Margin="25,4,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrG3}"
                         Text="{DynamicResource Settings.GrayMode.Hint}"/>
            </StackPanel>
          </Border>

          <!-- 回显当前真正生效的 token 字典：换主题时这里也会跟着变，是"确实生效了"的直接证据 -->
          <TextBlock x:Name="CurrentThemeText" FontSize="11" Margin="0,8,0,0"
                     Foreground="{DynamicResource BrG4}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.5 功能隐藏 ==================== -->
      <!--
        对应 PCL-CE 的「隐藏功能」卡片（PageSetupUI.xaml.cs:717 的 HiddenRefresh）。
        PCL 用一堆反向语义的开关（FunctionHidden = 「把隐藏功能这张卡藏起来」）；
        UMango 改成「直接写要藏哪些入口」，并保留一个「临时显示全部」的开关。
        全部藏起来时仍会留下「设置」入口 —— 否则用户进不去把设置改回来。
      -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Settings.Hidden.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Hidden.Hint}"/>

          <TextBox Margin="0,10,0,0"
                   Text="{Binding HiddenEntries, UpdateSourceTrigger=PropertyChanged}"/>

          <CheckBox Style="{DynamicResource PclSwitch}" Margin="0,10,0,0"
                    Content="{DynamicResource Settings.Hidden.ForceShow}"
                    IsChecked="{Binding HideForceShow, Mode=TwoWay}"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.6 高级材质（模糊） ==================== -->
      <!--
        对应 PCL 的「高级材质」：UiBlur（开关）/ UiBlurValue（半径）/
        UiBlurSamplingRate（采样率）/ UiBlurType（核类型）。
        PCL 把这些值写成应用级资源给 BlurBorder 控件读；
        UMango 直接给窗口根节点挂 AdaptiveBlurEffect（同一份 Apache-2.0 采用的效果）。
      -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Settings.Blur.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Blur.Hint}"/>

          <CheckBox Style="{DynamicResource PclSwitch}" Margin="0,10,0,0"
                    Content="{DynamicResource Settings.Blur.Enable}"
                    IsChecked="{Binding BlurEnabled, Mode=TwoWay}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Blur.Radius}"/>
          <Slider Style="{DynamicResource PclSlider}" Margin="0,2,0,0"
                  Minimum="0" Maximum="60"
                  Value="{Binding BlurRadius, Mode=TwoWay}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Blur.SamplingRate}"/>
          <Slider Style="{DynamicResource PclSlider}" Margin="0,2,0,0"
                  Minimum="0" Maximum="100"
                  Value="{Binding BlurSamplingRate, Mode=TwoWay}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Blur.KernelType}"/>
          <ComboBox x:Name="BlurKernelBox" Margin="0,4,0,0"
                    ItemsSource="{Binding BlurKernelTypes}"
                    SelectedItem="{Binding SelectedBlurKernelType, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="BlurKernelBox_SelectionChanged"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.7 动画 ==================== -->
      <!--
        需求原文：「动画矢量故意镜像 PCL-CE（列表 = 垂直进入 vs PCL 的水平；
        对话框 = 右滑 vs PCL 的左滑），并暴露为全局可切换设置。」
        所以这里的重点是**两种矢量都能选**，而不是只留一种。
      -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Settings.Section.Animation}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Animation.Hint}"/>

          <CheckBox x:Name="AnimationToggle" Style="{DynamicResource PclSwitch}" Margin="0,10,0,0"
                    Content="{DynamicResource Settings.Animation.Enable}" IsChecked="{Binding AnimationEnabled, Mode=TwoWay}"/>
          <TextBlock FontSize="12" Margin="25,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Animation.DisableHint}"/>

          <TextBlock FontSize="12" Margin="0,12,0,4"
                     Foreground="{DynamicResource BrG3}" Text="{DynamicResource Settings.Animation.Direction}"/>
          <ListBox x:Name="AnimationDirectionList" BorderThickness="0" Background="Transparent"
                   ItemsSource="{Binding AnimationDirections}"
                   SelectedItem="{Binding SelectedAnimationDirection, Mode=TwoWay}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource BrG8}"
                        BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                        SnapsToDevicePixels="True">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrC1}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11" Margin="0,3,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource BrG3}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <TextBlock FontSize="12" Margin="0,8,0,4"
                     Foreground="{DynamicResource BrG3}"
                     Text="{Binding AnimationSpeedFactor, StringFormat='{DynamicResource Fmt.SpeedFactor}'}"/>
          <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                  Value="{Binding AnimationSpeedFactor, Mode=TwoWay}"
                  Foreground="{DynamicResource BrC3}"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.7 语言 ==================== -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}"
                     Text="{DynamicResource Settings.Section.Language}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Language.Hint}"/>

          <!-- 语言下拉：选中即应用（与主题族一致的交互）。DisplayMemberPath 指向
               LanguageOption.DisplayName，因此列表里显示"简体中文（中国大陆）"这种
               各语言自称，而不是干巴巴的语言代码。 -->
          <ComboBox x:Name="LanguageBox" Margin="0,10,0,0"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="LanguageBox_SelectionChanged"
                    MinWidth="220" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.8 检查更新 ==================== -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}"
                     Text="{DynamicResource Settings.Update.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{Binding Update.CurrentVersionText, StringFormat='{DynamicResource Settings.Update.CurrentVersion}'}"/>

          <!-- 状态行 + 两个按钮同一行：检查更新是低频操作，没必要让按钮占一整行 -->
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{DynamicResource PclButton}"
                    Content="{DynamicResource Settings.Update.Check}"
                    Command="{Binding Update.CheckCommand}"
                    IsEnabled="{Binding Update.IsBusy, Converter={StaticResource InverseBool}}"/>
            <Button Style="{DynamicResource PclButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Settings.Update.Apply}"
                    Command="{Binding Update.ApplyCommand}"
                    IsEnabled="{Binding Update.HasUpdate}"/>
            <TextBlock FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource BrG2}"
                       Text="{Binding Update.StatusMessage}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================== ①.9 网络代理 ==================== -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}"
                     Text="{DynamicResource Settings.Proxy.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Proxy.Hint}"/>

          <!-- 代理模式：直连 / 跟随系统 / 自定义 -->
          <ComboBox x:Name="ProxyModeBox" Margin="0,10,0,0"
                    ItemsSource="{Binding ProxyModes}"
                    SelectedItem="{Binding SelectedProxyMode, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="ProxyModeBox_SelectionChanged"/>

          <!-- 自定义代理地址 + 用户名 + 密码：只在「自定义」模式下有意义 -->
          <StackPanel x:Name="ProxyCustomPanel" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBox x:Name="ProxyAddressBox" Margin="0,0,0,6"
                     Text="{Binding ProxyAddress, UpdateSourceTrigger=PropertyChanged}"/>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0" x:Name="ProxyUserBox"
                       Text="{Binding ProxyUsername, UpdateSourceTrigger=PropertyChanged}"/>
              <PasswordBox Grid.Column="2" x:Name="ProxyPasswordBox"
                           PasswordChanged="ProxyPasswordBox_PasswordChanged"/>
            </Grid>
          </StackPanel>

          <!-- 系统代理探测状态：让「跟随系统」不是一句空话 -->
          <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{Binding ProxyStatusMessage}"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.10 公告源 ==================== -->
      <!-- 公告是远程内容，所以源地址由用户自己填：留空就不抓取，也不访问任何默认地址。
           公告里的按钮只能触发白名单里的动作（见 Core 的 AnnouncementActionRegistry）。 -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}"
                     Text="{DynamicResource Announcement.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Announcement.Hint}"/>

          <TextBox x:Name="AnnouncementSourceBox" Margin="0,10,0,0"
                   Text="{Binding AnnouncementSource, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{Binding AnnouncementStatusMessage}"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.11 动态背景 ==================== -->
      <!-- 对应 PCL-CE 的「界面设置 → 背景」区（PageSetupUI.xaml:140-160 + ModSetup.cs:267-330）。
           PCL 的背景是窗口底层的一个 Canvas（ImgBack），图片走 ImageBrush，
           视频走 MediaElement；铺放方式有 9 种，「智能」是条件判定。 -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}"
                     Text="{DynamicResource Settings.Background.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Background.Hint}"/>

          <CheckBox Style="{DynamicResource PclCheckBox}" Margin="0,10,0,0"
                    Content="{DynamicResource Settings.Background.Enabled}"
                    IsChecked="{Binding BackgroundEnabled, Mode=TwoWay}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Background.Directory}"/>
          <TextBox Margin="0,4,0,0"
                   Text="{Binding BackgroundDirectory, UpdateSourceTrigger=PropertyChanged}"/>

          <CheckBox Style="{DynamicResource PclCheckBox}" Margin="0,10,0,0"
                    Content="{DynamicResource Settings.Background.VideoEnabled}"
                    IsChecked="{Binding BackgroundVideoEnabled, Mode=TwoWay}"/>

          <CheckBox Style="{DynamicResource PclCheckBox}" Margin="0,6,0,0"
                    Content="{DynamicResource Settings.Background.ForcePlay}"
                    IsChecked="{Binding BackgroundForcePlay, Mode=TwoWay}"/>

          <!-- 不透明度：PCL 用千分比（0~1000），这里沿用同一刻度 -->
          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Background.Opacity}"/>
          <Slider Style="{DynamicResource PclSlider}" Margin="0,2,0,0"
                  Minimum="0" Maximum="1000"
                  Value="{Binding BackgroundOpacity, Mode=TwoWay}"/>

          <!-- 模糊半径：0 表示不模糊（PCL 同样是 0 = 不模糊） -->
          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Background.Blur}"/>
          <Slider Style="{DynamicResource PclSlider}" Margin="0,2,0,0"
                  Minimum="0" Maximum="20"
                  Value="{Binding BackgroundBlur, Mode=TwoWay}"/>

          <!-- 铺放方式：9 种，顺序与 PCL 的下拉框一致 -->
          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Background.Suit}"/>
          <ComboBox x:Name="BackgroundSuitBox" Margin="0,4,0,0"
                    ItemsSource="{Binding BackgroundSuits}"
                    SelectedItem="{Binding BackgroundSuit, Mode=TwoWay}"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="BackgroundSuitBox_SelectionChanged"/>

          <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{Binding BackgroundStatusMessage}"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.12 窗口外观 ==================== -->
      <!-- 对应 PCL-CE 的「界面设置 → 窗口」区。这些项全部由 SetupObserver（配置观察者）
           直接落到运行中的 MainWindow 上，所以改完即生效、无需重启。 -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}"
                     Text="{DynamicResource Settings.Appearance.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Appearance.WindowHint}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Appearance.Opacity}"/>
          <Slider Style="{DynamicResource PclSlider}" Margin="0,2,0,0"
                  Minimum="200" Maximum="1000"
                  Value="{Binding WindowOpacity, Mode=TwoWay}"/>

          <CheckBox Style="{DynamicResource PclCheckBox}" Margin="0,10,0,0"
                    Content="{DynamicResource Settings.Appearance.LockSize}"
                    IsChecked="{Binding LockWindowSize, Mode=TwoWay}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Appearance.Font}"/>
          <TextBox Margin="0,4,0,0"
                   Text="{Binding UiFont, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Appearance.TitleBarText}"/>
          <TextBox Margin="0,4,0,0"
                   Text="{Binding TitleBarText, UpdateSourceTrigger=PropertyChanged}"/>

          <CheckBox Style="{DynamicResource PclCheckBox}" Margin="0,10,0,0"
                    Content="{DynamicResource Settings.Appearance.TitleBarLeftAlign}"
                    IsChecked="{Binding TitleBarLeftAlign, Mode=TwoWay}"/>
        </StackPanel>
      </Border>

      <!-- ==================== ①.13 下载限额 ==================== -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}"
                     Text="{DynamicResource Settings.Limits.Section}"/>
          <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Settings.Limits.Hint}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Limits.Threads}"/>
          <TextBox Margin="0,4,0,0"
                   Text="{Binding DownloadThreadLimit, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Limits.PerHost}"/>
          <TextBox Margin="0,4,0,0"
                   Text="{Binding DownloadFileConnectionLimit, UpdateSourceTrigger=PropertyChanged}"/>

          <TextBlock FontSize="12" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG2}"
                     Text="{DynamicResource Settings.Limits.Speed}"/>
          <TextBox Margin="0,4,0,0"
                   Text="{Binding DownloadSpeedLimit, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
      </Border>

      <!-- ==================== ② 调试 ==================== -->
      <Border Style="{DynamicResource PclCard}" Padding="14" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Settings.Section.Debug}"/>
          <Border Margin="0,8,0,0" Padding="10,9" CornerRadius="4"
                  Background="{DynamicResource BrCard}"
                  BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                  SnapsToDevicePixels="True">
            <StackPanel>
              <!-- 绑定写到 SettingsViewModel.DebugMode，它写穿到 Core 的静态开关 TerminalBridge.DebugMode -->
              <CheckBox x:Name="DebugToggle" Style="{DynamicResource PclSwitch}"
                        Content="{DynamicResource Settings.DebugMode}" IsChecked="{Binding DebugMode, Mode=TwoWay}"/>
              <TextBlock FontSize="12" Margin="25,4,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrG3}"
                         Text="{DynamicResource Settings.DebugMode.Hint}"/>
            </StackPanel>
          </Border>
          <!-- 日志保留条数（对应 PCL-CE 的「最大日志行数」滑块） -->
          <Border Margin="0,8,0,0" Padding="10,9" CornerRadius="4"
                  Background="{DynamicResource BrCard}"
                  BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                  SnapsToDevicePixels="True">
            <StackPanel>
              <TextBlock FontSize="13" Text="{DynamicResource Settings.LogBufferCapacity}"/>
              <Slider Minimum="200" Maximum="50000" TickFrequency="100" IsSnapToTickEnabled="False"
                      Margin="0,6,0,0" Value="{Binding LogBufferCapacity, Mode=TwoWay}"/>
              <TextBlock FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrG3}"
                         Text="{DynamicResource Settings.LogBufferCapacity.Hint}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <!-- ==================== ③ 记录管理 ==================== -->
      <Border Style="{DynamicResource PclCard}" Padding="14">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Settings.Section.Records}"/>

          <!--
            统计：总次数 / 成功 / 失败。
            这三个数字与下面的明细列表都由视图侧从 Core 的 InstallRecordStore 现取现填
            （见 RefreshRecordViews）：本页有「重新加载」按钮，若统计绑定 ViewModel 的
            内存快照，重新加载后明细会更新而数字不会，出现自相矛盾的界面。
          -->
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel>
              <TextBlock x:Name="StatTotalText" Text="0" Style="{DynamicResource StatNumber}"/>
              <TextBlock Text="{DynamicResource Settings.Records.Total}" Style="{DynamicResource StatCaption}"/>
            </StackPanel>
            <Border Width="1" Margin="20,2,20,2" Background="{DynamicResource BrG6}"/>
            <StackPanel>
              <TextBlock x:Name="StatSuccessText" Text="0" Style="{DynamicResource StatNumber}"
                         Foreground="{DynamicResource BrC3}"/>
              <TextBlock Text="{DynamicResource Settings.Records.Success}" Style="{DynamicResource StatCaption}"/>
            </StackPanel>
            <Border Width="1" Margin="20,2,20,2" Background="{DynamicResource BrG6}"/>
            <StackPanel>
              <TextBlock x:Name="StatFailureText" Text="0" Style="{DynamicResource StatNumber}"
                         Foreground="{DynamicResource BrRed}"/>
              <TextBlock Text="{DynamicResource Settings.Records.Failed}" Style="{DynamicResource StatCaption}"/>
            </StackPanel>
          </StackPanel>

          <!-- 按包源的次数（降序，条形按最大次数等比缩放；数据由视图侧整理后赋值给 ItemsSource） -->
          <TextBlock Text="{DynamicResource Settings.Records.BySource}" FontSize="12" FontWeight="SemiBold" Margin="0,16,0,0"
                     Foreground="{DynamicResource BrC1}"/>
          <ItemsControl x:Name="SourceCountList" Margin="0,6,0,0"
                        ItemTemplate="{DynamicResource SourceCountRowTemplate}"/>
          <TextBlock x:Name="SourceCountEmpty" Text="{DynamicResource Settings.Records.EmptyCounts}" FontSize="12" Margin="0,2,0,0"
                     Foreground="{DynamicResource BrG4}" Visibility="Collapsed"/>

          <Border Height="1" Margin="0,16,0,0" Background="{DynamicResource BrG6}"/>

          <!-- 最近记录（时间倒序，最多 50 条） -->
          <TextBlock Text="{DynamicResource Settings.Records.Recent}" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,0"
                     Foreground="{DynamicResource BrC1}"/>
          <TextBlock Text="{DynamicResource Settings.Records.RecentHint}" FontSize="11" Margin="0,2,0,0"
                     Foreground="{DynamicResource BrG3}"/>

          <!-- 表头：列宽与 RecordRowTemplate 保持一致，改动时两处要一起改 -->
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="100"/>
              <ColumnDefinition Width="80"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="70"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Settings.Records.Column.Time}" Style="{DynamicResource ColumnCaption}"/>
            <TextBlock Grid.Column="1" Text="{DynamicResource Settings.Records.Column.Source}" Style="{DynamicResource ColumnCaption}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource Settings.Records.Column.Package}" Style="{DynamicResource ColumnCaption}"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource Settings.Records.Column.Action}" Style="{DynamicResource ColumnCaption}"/>
            <TextBlock Grid.Column="4" Text="{DynamicResource Settings.Records.Column.Result}" Style="{DynamicResource ColumnCaption}"/>
            <TextBlock Grid.Column="5" Text="{DynamicResource Settings.Records.Column.Duration}" Style="{DynamicResource ColumnCaption}"
                       HorizontalAlignment="Right"/>
          </Grid>
          <Border Height="1" Margin="0,6,0,0" Background="{DynamicResource BrG6}"/>

          <ItemsControl x:Name="RecordList" ItemTemplate="{DynamicResource RecordRowTemplate}"/>
          <TextBlock x:Name="RecordEmpty" Text="{DynamicResource Settings.Records.Empty}"
                     FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG4}" Visibility="Collapsed"/>

          <!-- 记录文件位置：排查"记录去哪了"时最常需要的信息 -->
          <TextBlock x:Name="RecordStorePathText" FontSize="11" Margin="0,10,0,0"
                     Foreground="{DynamicResource BrG4}" TextTrimming="CharacterEllipsis"/>

          <!-- 操作按钮：「重新加载」重读磁盘；「清空记录」不可撤销，命令内部带二次确认 -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="BtnReload" Content="{DynamicResource Settings.Records.Reload}"
                    Style="{DynamicResource PclActionButton}" Click="Reload_Click"/>
            <!-- 用 RelativeSource 找页面自身，而不是 ElementName="PageRoot"：
                 根元素自身的 x:Name 是否进入本文件的名称范围属于 WPF 的灰色地带
                 （本机无法运行 WPF，只能静态推断），而 FindAncestor 是标准做法
                 （下载页的 InstallCommand 也是这么写的）。两种写法在本页都会拿到同一个实例，
                 这里选不会静默失效的那个 —— 否则「清空记录」会变成点不动的按钮。 -->
            <Button x:Name="BtnClearRecords" Content="{DynamicResource Settings.Records.Clear}" Margin="10,0,0,0"
                    Style="{DynamicResource PclDangerButton}"
                    Command="{Binding DataContext.ClearRecordsCommand,
                                      RelativeSource={RelativeSource AncestorType={x:Type views:SettingsView}}}"
                    ToolTip="{DynamicResource Tip.ClearRecords}"/>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

<UserControl x:Class="UMango.App.Views.DownloaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BrCard}">
  <!--
    ============================================================================
    下载器页（对应 PCL-CE 的「百宝箱」下载功能）
    ============================================================================
    需求：弃用 PCL2 网页下载代码，重新集成 aria2 / bittorrent / ed2k，注意开源许可。

    本页刻意体现三件事：
      1. **协议自动识别**：粘贴链接后就告诉用户识别成什么协议、交给哪个引擎，
         用户不必知道 magnet 走 BitTorrent、ed2k 走 aMule；
      2. **许可说明直接摆出来**：每个引擎的 LicenseNote 可见，其中写明
         「不链接也不分发」GPL 工具二进制 —— 避免用户误以为本程序打包了 aria2/aMule；
      3. **拿不到进度就不显示假百分比**：不确定态进度条 + 「已下载 X MiB」文案。

    约定（与其它页面一致）：颜色一律 {DynamicResource Xxx}；卡片用 PclCard；
    小节标题用 PclSectionTitle。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Padding="20,16,20,20" Background="{DynamicResource BrBg}">
    <StackPanel MaxWidth="880" HorizontalAlignment="Left">

      <!-- ===================== 1) 下载任务卡 ===================== -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14">
        <StackPanel>
          <TextBlock Text="新建下载" Style="{DynamicResource PclSectionTitle}"/>

          <!-- 链接输入 -->
          <TextBox x:Name="UrlBox" Margin="0,12,0,0" Padding="8,6"
                   Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                   Background="{DynamicResource BrCard}"
                   Foreground="{DynamicResource BrC1}"
                   BorderBrush="{DynamicResource BrG6}"/>

          <!-- 协议与引擎提示（随输入实时变化） -->
          <TextBlock Text="{Binding ProtocolHint}" Margin="0,6,0,0" FontSize="12"
                     Foreground="{DynamicResource BrG3}" TextWrapping="Wrap"/>

          <!-- 输出目录 -->
          <TextBlock Text="保存到" Margin="0,12,0,4" FontSize="12"
                     Foreground="{DynamicResource BrG3}"/>
          <TextBox Padding="8,6"
                   Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"
                   Background="{DynamicResource BrCard}"
                   Foreground="{DynamicResource BrC1}"
                   BorderBrush="{DynamicResource BrG6}"/>

          <!-- 操作按钮 -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="开始下载" Width="96" Height="30" Margin="0,0,8,0"
                    Command="{Binding StartCommand}"/>
            <Button Content="取消" Width="72" Height="30" Margin="0,0,8,0"
                    Command="{Binding CancelCommand}"/>
            <Button Content="清空输出" Width="96" Height="30"
                    Command="{Binding ClearTerminalCommand}"/>
          </StackPanel>

          <!-- 进度 -->
          <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                       Value="{Binding ProgressFraction, FallbackValue=0}"
                       IsIndeterminate="{Binding IsProgressKnown, Converter={StaticResource InverseBool}}"
                       Foreground="{DynamicResource BrC3}"
                       Background="{DynamicResource BrG6}" BorderThickness="0"/>

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{DynamicResource BrC1}"/>
            <TextBlock Text="{Binding SpeedText, StringFormat=  ·  {0}}" FontSize="12"
                       Foreground="{DynamicResource BrG3}"/>
            <TextBlock Text="{Binding EtaText, StringFormat=  ·  剩余 {0}}" FontSize="12"
                       Foreground="{DynamicResource BrG3}"/>
          </StackPanel>

          <!-- 成功落盘路径 -->
          <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Visibility="{Binding SavedPath, Converter={StaticResource BoolToVis}}"
                     Text="{Binding SavedPath, StringFormat=已保存到：{0}}"/>

          <!-- 错误条 -->
          <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                  Background="{DynamicResource BrRedBack}"
                  Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrRed}"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- ===================== 2) 下载引擎卡 ===================== -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="下载引擎" Style="{DynamicResource PclSectionTitle}"/>
          <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="引擎按协议自动选择：aria2 覆盖 HTTP/FTP/BitTorrent/元链接；eD2k 需要专用客户端；内置引擎作为兜底。"/>
          <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Engines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource BrG8}"
                        BorderBrush="{DynamicResource BrG6}" BorderThickness="1">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource BrRed}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsAvailable}" Value="True">
                                <Setter Property="Fill" Value="{DynamicResource BrC3}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                      <TextBlock Text="{Binding DisplayName}" Margin="8,0,0,0"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource BrC1}"/>
                      <TextBlock Text="{Binding ProtocolsText}" Margin="10,0,0,0"
                                 FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource BrG3}"/>
                    </StackPanel>
                    <!-- 许可说明：GPL 工具的"不链接也不分发"必须让用户看到 -->
                    <TextBlock Text="{Binding LicenseNote}" Margin="16,4,0,0"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrG4}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===================== 3) 终端输出卡（非黑底！）===================== -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="终端输出" Style="{DynamicResource PclSectionTitle}"/>
          <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG4}"
                     Text="与页面同底色的原生回传，不是黑底嵌入终端；stderr 以红色区分。"/>
          <!-- 固定高度 + 自身滚动：输出可能很长，不能把页面撑开 -->
          <ScrollViewer Height="220" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                        Background="{DynamicResource BrG8}">
            <ItemsControl ItemsSource="{Binding TerminalLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding At, StringFormat={}{0:HH:mm:ss}}" FontSize="11"
                               FontFamily="Consolas, Menlo, monospace" Margin="6,1,8,1"
                               Foreground="{DynamicResource BrG4}"/>
                    <TextBlock Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                               FontFamily="Consolas, Menlo, monospace" Margin="0,1,6,1"
                               Foreground="{DynamicResource BrC1}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Foreground" Value="{DynamicResource BrC1}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStdErr}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource BrRed}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

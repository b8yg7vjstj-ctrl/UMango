<UserControl x:Class="UMango.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UMango.App.ViewModels"
             Background="{DynamicResource BrCard}">
  <!--
    ============================================================================
    日志页
    ============================================================================
    存在的实际理由：应用主要在 Windows 上运行、开发在 macOS ——
    真机出问题时，开发侧唯一能拿到的材料就是用户发回来的一份日志。
    因此「导出诊断包」不是锦上添花：它把日志/设置/记录/系统信息打成**一个 zip**，
    用户点一下就能整份发出。

    约定与其它页面一致：颜色一律 {DynamicResource}；卡片用 PclCard。
  -->
  <Grid Margin="20,16,20,20" Background="{DynamicResource BrBg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 操作条 -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Column="0" Text="{DynamicResource Log.Column.Level}" FontSize="12" VerticalAlignment="Center"
                 Foreground="{DynamicResource BrG3}"/>

      <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="120" Height="26"
                ItemsSource="{Binding Levels}"
                SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"
                DisplayMemberPath="Title"/>

      <TextBlock Grid.Column="2" Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center"
                 TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource BrG3}"
                 Text="{Binding StatusMessage}"/>

      <StackPanel Grid.Column="3" Orientation="Horizontal">
        <Button Content="{DynamicResource Log.Refresh}" Height="26" Padding="12,0" FontSize="12"
                Style="{DynamicResource DownloadSecondaryButton}"
                Command="{Binding RefreshCommand}"/>
        <Button Content="{DynamicResource Log.Clear}" Height="26" Padding="12,0" FontSize="12" Margin="6,0,0,0"
                Style="{DynamicResource DownloadSecondaryButton}"
                Command="{Binding ClearCommand}"/>
        <Button Content="{DynamicResource Log.OpenFolder}" Height="26" Padding="12,0" FontSize="12" Margin="6,0,0,0"
                Style="{DynamicResource DownloadSecondaryButton}"
                Command="{Binding OpenFolderCommand}"/>
        <Button Content="{DynamicResource Log.Export}" Height="26" Padding="12,0" FontSize="12" Margin="6,0,0,0"
                Style="{DynamicResource DownloadPrimaryButton}"
                Command="{Binding ExportCommand}"
                ToolTipService.Placement="Right" ToolTip="把日志、设置、记录与系统信息打成一个 zip 放到桌面，方便整份发回"/>
      </StackPanel>
    </Grid>

    <!-- 提示与错误 -->
    <StackPanel Grid.Row="1" Margin="0,8,0,0">
      <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource BrG4}"
                 Text="{DynamicResource Log.StorageHint}"/>

      <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4"
              Background="{DynamicResource BrRedBack}"
              Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource BrRed}"/>
      </Border>
    </StackPanel>

    <!-- 日志列表：用 ListBox 以获得虚拟化 —— 几千条时 ObservableCollection + ItemsControl 会明显卡顿 -->
    <Border Grid.Row="2" Margin="0,12,0,0" Style="{DynamicResource PclCard}" Padding="0">
      <ListBox ItemsSource="{Binding Entries}"
               Background="Transparent" BorderThickness="0"
               FocusVisualStyle="{x:Null}"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Grid Margin="10,3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" FontSize="11"
                         FontFamily="Consolas, Menlo, monospace"
                         Text="{Binding At, StringFormat={}{0:HH:mm:ss.fff}}"
                         Foreground="{DynamicResource BrG4}"/>

              <!-- 级别：错误用红色，警告用琥珀色（颜色帮助快速定位，但文字仍强调色相为蓝的合规要求） -->
              <TextBlock Grid.Column="1" Margin="8,0,0,0" FontSize="11" MinWidth="30"
                         FontFamily="Consolas, Menlo, monospace"
                         Text="{Binding LevelText}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource BrG3}"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Level}" Value="Warn">
                        <Setter Property="Foreground" Value="{DynamicResource BrWarnAmber}"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding Level}" Value="Error">
                        <Setter Property="Foreground" Value="{DynamicResource BrRed}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>

              <TextBlock Grid.Column="2" Margin="8,0,0,0" FontSize="11"
                         FontFamily="Consolas, Menlo, monospace"
                         Text="{Binding Category, StringFormat=[{0}]}"
                         Foreground="{DynamicResource BrC5}"/>

              <TextBlock Grid.Column="3" Margin="8,0,0,0" FontSize="11" TextWrapping="Wrap"
                         FontFamily="Consolas, Menlo, monospace"
                         Text="{Binding Message}"
                         Foreground="{DynamicResource BrC1}"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </Grid>
</UserControl>

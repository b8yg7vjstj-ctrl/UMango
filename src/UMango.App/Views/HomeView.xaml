<UserControl x:Class="UMango.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
  <!--
    ============================================================================
    主页（概览）：应用卡 / 包源状态卡 / 使用统计卡 / 最近操作卡
    ============================================================================
    约定：
      · 颜色一律 {DynamicResource}，不写死色值 —— 否则运行时切换主题（PCL 经典 ↔ Win10 Fluent
        × 浅色/深色）不会生效：StaticResource 只在 XAML 加载时求值一次。
      · 卡片用共用样式 PclCard（底色 BrCard / 边框 BrG6 / 圆角 6），标题用 PclSectionTitle。
      · 整页放在 ScrollViewer 里，窗口变小时内容可滚动而不被裁掉
        （内容 MaxWidth 限宽 + 左对齐，避免宽屏下正文拉成一行读不完的长句）。
      · 唯一的例外是状态点的画刷：它由 ViewModel 按主题 key 解析后以 Brush 传出
        （见 HomeSourceStatus.StatusBrush 的说明），这样颜色仍然随主题变化。
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Padding="20,16,20,20" Background="Transparent">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">

      <!-- ===================== 1) 应用卡 ===================== -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14">
        <StackPanel>
          <TextBlock Text="{DynamicResource Home.Title}" FontSize="22" FontWeight="Bold"
                     Foreground="{DynamicResource BrC1}"/>
          <TextBlock Text="{DynamicResource Home.Subtitle}" FontSize="12" Margin="0,4,0,0"
                     Foreground="{DynamicResource BrG3}"/>

          <Border Height="1" Margin="0,12,0,10" Background="{DynamicResource BrG6}"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Home.Platform}" FontSize="12"
                       Margin="0,0,0,6" Foreground="{DynamicResource BrG3}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding PlatformText}" FontSize="12"
                       Margin="0,0,0,6" Foreground="{DynamicResource BrC1}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Home.Architecture}" FontSize="12"
                       Margin="0,0,0,6" Foreground="{DynamicResource BrG3}"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ArchitectureText}" FontSize="12"
                       Margin="0,0,0,6" Foreground="{DynamicResource BrC1}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Home.Platform.Windows}" FontSize="12"
                       Foreground="{DynamicResource BrG3}"/>
            <!--
              这里是「是 / 否」两个文本二选一，而不是在 ViewModel 里造一个只为显示用的
              "是否 Windows" 字符串：布尔属性才是数据本身，显示文案留在界面层。
              注：这里**必须用 TextBlock 而不是 Run** —— WPF 的 Run（Inline/TextElement）没有
              Visibility 属性，写 `Run.Visibility` 会直接编译失败（MC3072）。
              "是"用转换器、"否"用取反的 DataTrigger，都不需要在 XAML 里做字符串格式化。
            -->
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
              <TextBlock Text="{Binding RunningOnText}" FontSize="12"
                         Foreground="{DynamicResource BrC1}"/>
              <TextBlock Text="{DynamicResource Home.Yes}" FontSize="12" Foreground="{DynamicResource BrC1}"
                         Visibility="{Binding IsWindows, Converter={StaticResource BoolToVis}}"/>
              <TextBlock Text="{DynamicResource Home.No}" FontSize="12" Foreground="{DynamicResource BrC1}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsWindows}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ===================== 2) 包源状态卡 ===================== -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Home.Section.Packages}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="{DynamicResource Common.Action.Refresh}" Padding="12,3" Cursor="Hand" FontSize="12"
                    Foreground="{DynamicResource BrC1}" Background="{DynamicResource BrG8}"
                    BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                    ToolTip="{DynamicResource Tip.ReprobeAll}"
                    Command="{Binding RefreshCommand}"/>
          </Grid>
          <TextBlock Text="{DynamicResource Home.AllSourcesHint}"
                     FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"/>

          <!-- 列标题：包源 / 安装目录 / 状态；数据行沿用同样的列宽，保证纵向对齐 -->
          <Grid Margin="0,12,0,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="96"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="112"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{DynamicResource Home.Column.Package}" FontSize="11" Foreground="{DynamicResource BrG4}"/>
            <TextBlock Grid.Column="2" Text="{DynamicResource Home.Column.Directory}" FontSize="11" Foreground="{DynamicResource BrG4}"/>
            <TextBlock Grid.Column="3" Text="{DynamicResource Home.Column.State}" FontSize="11" Foreground="{DynamicResource BrG4}"/>
          </Grid>
          <Border Height="1" Background="{DynamicResource BrG6}"/>

          <ItemsControl ItemsSource="{Binding Sources}" Margin="0,2,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="112"/>
                  </Grid.ColumnDefinitions>

                  <!-- 状态点：字形区分可用/不可用/平台不支持，颜色由 ViewModel 按主题 key 解析 -->
                  <TextBlock Grid.Column="0" Text="{Binding StatusGlyph}" FontSize="10"
                             Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>

                  <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrC1}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>

                  <!-- 安装目录可能很长：省略号 + 悬浮查看完整路径 -->
                  <TextBlock Grid.Column="2" Text="{Binding Subtitle}" FontSize="12"
                             Margin="0,0,10,0" Foreground="{DynamicResource BrG2}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Subtitle}"/>

                  <TextBlock Grid.Column="3" Text="{Binding StateText}" FontSize="12"
                             Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                             HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!--
            探测明细（CLI 缺失、网络不可达等）：整段文本，只含有内容的包源。
            逐行渲染会为"正常且无话可说"的包源留下空行，把列表拉长却看不到信息。
          -->
          <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                  Background="{DynamicResource BrG8}"
                  Visibility="{Binding HasSourceDetails, Converter={StaticResource BoolToVis}}">
            <StackPanel>
              <TextBlock Text="{DynamicResource Home.ProbeDetail}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource BrG2}"/>
              <TextBlock Text="{Binding SourceDetailText}" FontSize="11" Margin="0,4,0,0"
                         TextWrapping="Wrap" Foreground="{DynamicResource BrG3}"/>
            </StackPanel>
          </Border>

          <!-- ★ 未在真机验证的如实提示（Core 的 VerificationNote），有才显示 -->
          <Border Margin="0,8,0,0" Padding="10,8" CornerRadius="4"
                  Background="{DynamicResource BrG8}"
                  Visibility="{Binding HasVerificationNotes, Converter={StaticResource BoolToVis}}">
            <!-- Grid 两列：同 DownloaderView 的理由（横向 StackPanel 使 TextWrapping 失效） -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="!" FontSize="12" FontWeight="Bold" Margin="0,0,8,0"
                         Foreground="{DynamicResource BrG2}"/>
              <TextBlock Grid.Column="1" Text="{Binding VerificationText}" FontSize="11" TextWrapping="Wrap"
                         Foreground="{DynamicResource BrG2}"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- ===================== 3) 使用统计卡（次数记录） ===================== -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Home.Section.Statistics}"/>

          <!-- 三个计数：总次数 / 成功 / 失败 -->
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <StackPanel Margin="0,0,28,0">
              <TextBlock Text="{DynamicResource Home.Statistics.Total}" FontSize="11" Foreground="{DynamicResource BrG3}"/>
              <TextBlock Text="{Binding TotalCount}" FontSize="20" FontWeight="Bold"
                         Margin="0,2,0,0" Foreground="{DynamicResource BrC1}"/>
            </StackPanel>
            <StackPanel Margin="0,0,28,0">
              <TextBlock Text="{DynamicResource Home.Statistics.Success}" FontSize="11" Foreground="{DynamicResource BrG3}"/>
              <TextBlock Text="{Binding SuccessCount}" FontSize="20" FontWeight="Bold"
                         Margin="0,2,0,0" Foreground="{DynamicResource BrC3}"/>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="{DynamicResource Home.Statistics.Failed}" FontSize="11" Foreground="{DynamicResource BrG3}"/>
              <TextBlock Text="{Binding FailureCount}" FontSize="20" FontWeight="Bold"
                         Margin="0,2,0,0" Foreground="{DynamicResource BrRed}"/>
            </StackPanel>
          </StackPanel>

          <TextBlock Text="{Binding SuccessRateText}" FontSize="12" Margin="0,8,0,0"
                     Foreground="{DynamicResource BrG2}"/>
          <TextBlock Text="{Binding RecordsDetailText}" FontSize="11" Margin="0,2,0,0"
                     TextWrapping="Wrap" Foreground="{DynamicResource BrG4}"/>

          <!-- 按包源次数：需求「次数记录」的界面落点 -->
          <TextBlock Text="{DynamicResource Home.Statistics.BySource}" FontSize="12" FontWeight="SemiBold" Margin="0,14,0,4"
                     Foreground="{DynamicResource BrC1}"/>
          <ItemsControl ItemsSource="{Binding SourceCounts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12"
                             Foreground="{DynamicResource BrG2}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="1" Text="{Binding Count}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource BrC1}"/>
                  <TextBlock Grid.Column="2" Text="{Binding ShareText}" FontSize="11"
                             Foreground="{DynamicResource BrG4}" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===================== 3.5) 自定义主页卡 =====================
           对应 PCL-CE 的 PageLaunchRight（远程 XAML 主页）。
           ⚠️ UMango **不加载远程 XAML**（那是任意代码执行面，见 Core 的
           HomepageManifest 头部说明）—— 这里渲染的是一份**声明式 JSON 清单**，
           内容只可能是标题/正文/链接/图标名/已注册动作，装不出可执行的东西。
           清单路径与提示行让用户知道「东西放哪儿、为什么没显示」。 -->
      <!-- 这一块**始终显示**：没配清单时也要让用户知道「清单放哪儿」，
           否则功能等于不存在（用户找不到入口就永远用不上）。
           没有卡片时只剩标题 + 路径 + 一句提示，看起来也像正常的空态。 -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Homepage.Section}"/>
          <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG4}"
                     Text="{Binding Homepage.ManifestPath}"/>
          <TextBlock FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{Binding Homepage.Hint}"
                     Visibility="{Binding Homepage.Hint, Converter={StaticResource NotEmptyToVis}}"/>

          <ItemsControl ItemsSource="{Binding Homepage.Cards}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrC1}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource BrG3}" TextWrapping="Wrap"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Body}" FontSize="12" Margin="0,5,0,0"
                               Foreground="{DynamicResource BrG2}" TextWrapping="Wrap"
                               Visibility="{Binding HasBody, Converter={StaticResource BoolToVis}}"/>

                    <!-- 标签行：用 ItemsControl 而不是塞进一个字符串，标签各自可换行 -->
                    <ItemsControl ItemsSource="{Binding Tags}" Margin="0,6,0,0"
                                  Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Background="{DynamicResource BrBg}" CornerRadius="3"
                                  Padding="6,2" Margin="0,0,6,0">
                            <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource BrG4}"/>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Content="{DynamicResource Homepage.OpenLink}" Click="{Binding OpenLinkCommand}"
                              Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"
                              Style="{DynamicResource PclButton}" Margin="0,0,8,0"/>
                      <Button Content="{DynamicResource Homepage.RunAction}" Click="{Binding RunActionCommand}"
                              Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                              Style="{DynamicResource PclButton}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource BrRed}"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===================== 3.6) 公告卡 =====================
           对应 PCL-CE 的公告弹窗（Modules/Updates/AnnouncementService）。
           公告是**远程内容**：它的按钮只能触发白名单里的动作
           （Core 的 AnnouncementActionRegistry 判定 + App 的 AnnouncementHost 实现），
           远程 JSON 无法引入任何新动作，也拿不到任意代码执行面。
           公告源在设置页填；留空时这一块只剩标题与提示，不发任何网络请求。 -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{DynamicResource PclSectionTitle}"
                       Text="{DynamicResource Announcement.Section}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="{DynamicResource Announcement.MarkShown}" Padding="12,3" Cursor="Hand" FontSize="12"
                      Foreground="{DynamicResource BrC1}" Background="{DynamicResource BrG8}"
                      BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                      Command="{Binding Announcements.MarkAllShownCommand}"
                      Visibility="{Binding Announcements.HasItems, Converter={StaticResource BoolToVis}}"/>
              <Button Content="{DynamicResource Common.Action.Refresh}" Margin="8,0,0,0" Padding="12,3" Cursor="Hand" FontSize="12"
                      Foreground="{DynamicResource BrC1}" Background="{DynamicResource BrG8}"
                      BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                      Command="{Binding Announcements.LoadCommand}"/>
            </StackPanel>
          </Grid>

          <TextBlock FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{Binding Announcements.Hint}"
                     Visibility="{Binding Announcements.Hint, Converter={StaticResource NotEmptyToVis}}"/>

          <ItemsControl ItemsSource="{Binding Announcements.Items}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                        CornerRadius="4" Padding="12,10" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrC1}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DateText}" FontSize="10" Margin="0,3,0,0"
                               Foreground="{DynamicResource BrG4}"
                               Visibility="{Binding HasDate, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="12" Margin="0,5,0,0"
                               Foreground="{DynamicResource BrG2}" TextWrapping="Wrap"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <Button Content="{Binding Btn1.Text}" Click="{Binding RunBtn1Command}"
                              Style="{DynamicResource PclButton}" Margin="0,0,8,0"
                              Visibility="{Binding HasBtn1, Converter={StaticResource BoolToVis}}"/>
                      <Button Content="{Binding Btn2.Text}" Click="{Binding RunBtn2Command}"
                              Style="{DynamicResource PclButton}"
                              Visibility="{Binding HasBtn2, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap" Foreground="{DynamicResource BrRed}"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===================== 4) 最近操作卡 ===================== -->
      <Border Style="{DynamicResource PclCard}" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Style="{DynamicResource PclSectionTitle}" Text="{DynamicResource Home.RecentOperations}"/>
          <TextBlock Text="{Binding RecentHintText}" FontSize="11" Margin="0,6,0,0"
                     TextWrapping="Wrap" Foreground="{DynamicResource BrG3}"/>

          <ItemsControl ItemsSource="{Binding RecentRecords}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 这一行的明细（错误码、安装目录、耗时毫秒）放在 ToolTip 里：
                     概览页的列表放不下，但完整信息又必须能查到。 -->
                <Grid Margin="0,4" ToolTip="{Binding DetailText}" ToolTipService.ShowDuration="20000">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <!-- 版本定宽 90：npm 的版本号可以很长，不定宽会把"操作/成败/时间"挤出卡片 -->
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="92"/>
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="{Binding StateGlyph}" FontSize="11"
                             Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>

                  <!-- 包名 / 版本 / 操作 / 成败 / 时间 —— 需求要求"最近操作"能看到这四项；
                       包源与错误码等更多信息在整行的悬浮提示里（见上面的 ToolTip 注释）。 -->
                  <TextBlock Grid.Column="1" Text="{Binding PackageName}" FontSize="12"
                             Foreground="{DynamicResource BrC1}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"/>

                  <TextBlock Grid.Column="2" Text="{Binding VersionText}" FontSize="11"
                             Margin="8,0,0,0" Foreground="{DynamicResource BrG4}"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                  <TextBlock Grid.Column="3" Text="{Binding ActionText}" FontSize="11"
                             Margin="10,0,0,0" Foreground="{DynamicResource BrG2}"
                             VerticalAlignment="Center"/>

                  <TextBlock Grid.Column="4" Text="{Binding StateText}" FontSize="11"
                             Margin="10,0,0,0" Foreground="{Binding StateBrush}"
                             VerticalAlignment="Center"/>

                  <TextBlock Grid.Column="5" Text="{Binding TimeText}" FontSize="11"
                             Margin="12,0,0,0" Foreground="{DynamicResource BrG3}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- 状态提示 / 错误提示：都放在页面底部，不打断内容阅读。
           源是 string?（不是 bool），所以必须用 NotEmptyToVis：喂给 BoolToVis 会永远 Collapsed。 -->
      <TextBlock Text="{Binding StatusMessage}" FontSize="11" Margin="0,12,0,0"
                 TextWrapping="Wrap" Foreground="{DynamicResource BrG3}"
                 Visibility="{Binding StatusMessage, Converter={StaticResource NotEmptyToVis}}"/>
      <TextBlock Text="{Binding ErrorMessage}" FontSize="11" Margin="0,6,0,0"
                 TextWrapping="Wrap" Foreground="{DynamicResource BrRed}"
                 Visibility="{Binding ErrorMessage, Converter={StaticResource NotEmptyToVis}}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>

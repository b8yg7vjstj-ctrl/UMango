<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UMango</AssemblyName>
    <RootNamespace>UMango.App</RootNamespace>
    <!-- 自写 Main（更新助手进程分支）：WPF 自动生成的 Main 仍在，
         必须显式指定入口点，否则 CS0017「程序定义了多个入口点」。 -->
    <StartupObject>UMango.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- 显式引用 CommunityToolkit.Mvvm 的原因（版本与 UMango.Core 保持一致，不引入新依赖）：
         NuGet 的 PackageReference 默认 PrivateAssets 含 analyzers，所以 Core 里的这个包
         传到 App 工程时只带来 lib/*.dll（ObservableObject 等基类可用），
         却**不带源生成器**；而 App 的 ViewModel 全靠 [ObservableProperty]/[RelayCommand]
         生成属性与命令，没有生成器就会大面积编译失败。
         注意：若其它 agent 也已在本文件加过同一行，保留一份即可（重复 PackageReference 会报 NU1504）。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- NAudio：背景音乐播放（MIT 许可，与 PCL-CE 用的同一套库、同一许可）。
         选 2.4.0 而不是 3.x：3.x 把 NAudio 拆成 Core/Wasapi/WinMM/Midi 等多个包，
         且目标框架只到 net9.0；2.4.0 提供 net6.0-windows7.0 资产，
         API 面（Mp3FileReader / AudioFileReader / WaveFileReader / WaveOutEvent）完全够用。
         FLAC 解码 NAudio 2.x 不含（只有 .NET Framework 专用的 NAudio.Flac 1.x 才有，
         且该包未声明许可）→ UMango 在 Core 层只把 .flac 记作「可识别格式」，
         真正能否解码由播放层判定，播不了就归类为「格式不支持」。 -->
    <PackageReference Include="NAudio" Version="2.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UMango.Core\UMango.Core.csproj" />
    <!-- UMango.Shell：两个界面壳共用的那一层（界面文案目录、ViewModel、可移植服务）。
         刻意是 net10.0（不设 UseWPF）—— 这样 macOS/Linux 上的 Avalonia 壳能引用同一份代码，
         不必复制一份（复制必然发散）。 -->
    <ProjectReference Include="..\UMango.Shell\UMango.Shell.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 像素着色器：自适应模糊效果用的 AdaptiveBlur.ps（自 PCL-CE 的 Apache-2.0 层采用）。
         .ps 是**已编译**的二进制，Build Action 必须是 Resource，
         否则 pack:// URI 取不到它。.hlsl 是对应的源码，一并带上便于追溯。 -->
    <Resource Include="Assets\Shaders\AdaptiveBlur.ps" />
    <Resource Include="Assets\Shaders\AdaptiveBlur.hlsl" />
  </ItemGroup>
</Project>

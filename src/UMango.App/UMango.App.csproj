<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>UMango</AssemblyName>
    <RootNamespace>UMango.App</RootNamespace>
    <!-- 自写 Main（更新助手进程分支）：WPF 自动生成的 Main 仍在，
         必须显式指定入口点，否则 CS0017「程序定义了多个入口点」。 -->
    <StartupObject>UMango.App.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <!-- 显式引用 CommunityToolkit.Mvvm 的原因（版本与 UMango.Core 保持一致，不引入新依赖）：
         NuGet 的 PackageReference 默认 PrivateAssets 含 analyzers，所以 Core 里的这个包
         传到 App 工程时只带来 lib/*.dll（ObservableObject 等基类可用），
         却**不带源生成器**；而 App 的 ViewModel 全靠 [ObservableProperty]/[RelayCommand]
         生成属性与命令，没有生成器就会大面积编译失败。
         注意：若其它 agent 也已在本文件加过同一行，保留一份即可（重复 PackageReference 会报 NU1504）。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UMango.Core\UMango.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 像素着色器：自适应模糊效果用的 AdaptiveBlur.ps（自 PCL-CE 的 Apache-2.0 层采用）。
         .ps 是**已编译**的二进制，Build Action 必须是 Resource，
         否则 pack:// URI 取不到它。.hlsl 是对应的源码，一并带上便于追溯。 -->
    <Resource Include="Assets\Shaders\AdaptiveBlur.ps" />
    <Resource Include="Assets\Shaders\AdaptiveBlur.hlsl" />
  </ItemGroup>
</Project>

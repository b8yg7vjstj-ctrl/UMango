<Window x:Class="UMango.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UMango" Height="620" Width="960" MinHeight="470" MinWidth="810"
        Background="{StaticResource BrBg}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <!--
    窗口外壳：沿用 PCL-CE 的结构
      · 四周 10px 留白 + 6px 圆角的卡片式窗口
      · 顶部 48px 标题栏：左 Logo / 中 四个 banner 选项卡 / 右 三大金刚键
      · 标题栏下方：左栏（随选项卡变化）+ 内容区
    三大金刚键使用 Windows 原生字形与行为（WPF 即 Windows 原生栈）。
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border Margin="10" CornerRadius="6" Background="White" SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
    </Border.Effect>
    <Border.Clip>
      <RectangleGeometry Rect="0,0,10000,10000" RadiusX="6" RadiusY="6"/>
    </Border.Clip>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="48"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== 标题栏 ===== -->
      <Grid Grid.Row="0" Background="{StaticResource BrTitleBar}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 左：Logo + 应用名（自绘，不使用 PCL 图片资源） -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="#33FFFFFF">
            <TextBlock Text="🥭" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="UMango" Foreground="White" FontSize="15" FontWeight="SemiBold"
                     Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 中：四个 banner 选项卡 -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
          <RadioButton x:Name="TabHome" Content="主页" Style="{StaticResource BannerTab}"
                       IsChecked="True" Checked="Tab_Checked" Tag="home"/>
          <RadioButton x:Name="TabDownload" Content="下载" Style="{StaticResource BannerTab}"
                       Checked="Tab_Checked" Tag="download"/>
          <RadioButton x:Name="TabSetup" Content="设置" Style="{StaticResource BannerTab}"
                       Checked="Tab_Checked" Tag="setup"/>
          <RadioButton x:Name="TabTools" Content="工具" Style="{StaticResource BannerTab}"
                       Checked="Tab_Checked" Tag="tools"/>
        </StackPanel>

        <!-- 右：三大金刚键（Windows 原生风格：46x32、hover 高亮、关闭为红） -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="BtnMin" Content="&#xE949;" Style="{StaticResource CaptionButton}"
                  Click="BtnMin_Click" ToolTip="最小化"/>
          <Button x:Name="BtnMax" Content="&#xE739;" Style="{StaticResource CaptionButton}"
                  Click="BtnMax_Click" ToolTip="最大化"/>
          <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource CaptionButtonClose}"
                  Click="BtnClose_Click" ToolTip="关闭"/>
        </StackPanel>
      </Grid>

      <!-- ===== 主体：左栏 + 内容区 ===== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="168"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BrC8}" BorderBrush="{StaticResource BrG6}"
                BorderThickness="0,0,1,0">
          <StackPanel x:Name="LeftRail" Margin="0,8,0,0"/>
        </Border>

        <Grid Grid.Column="1">
          <!-- 首页：概览 -->
          <StackPanel x:Name="PageHome" Margin="20">
            <TextBlock Text="UMango" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrC1}"/>
            <TextBlock Text="跨平台包管理器图形界面 · 基于 PCL-CE 架构重写"
                       FontSize="12" Foreground="{StaticResource BrG3}" Margin="0,4,0,0"/>
            <Border Margin="0,16,0,0" Padding="14" CornerRadius="6"
                    Background="{StaticResource BrG8}" BorderBrush="{StaticResource BrG6}" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="本次重构进度" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource BrC1}"/>
                <TextBlock Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource BrG2}"
                           TextWrapping="Wrap"
                           Text="已废弃 Flutter 第一版，改为 .NET 10 + WPF。&#x0a;已采用 PCL-CE 的任务/进度模型（ITask / ITaskProgressive / ITaskGroup / TaskCenter）。&#x0a;下一步：包管理器适配器、下载进度页（按下载方式列子项进度）、Windows10 Fluent 主题。"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- 下载：任务与子项进度（"按不同下载方式列明子项进度"的落地页） -->
          <Grid x:Name="PageDownload" Visibility="Collapsed" Margin="20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="下载进度" FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource BrC1}" Margin="0,0,0,10"/>
            <ListBox x:Name="TaskList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemTemplate="{StaticResource TaskItemTemplate}"/>
          </Grid>

          <!-- 设置 / 工具：占位 -->
          <StackPanel x:Name="PageSetup" Visibility="Collapsed" Margin="20">
            <TextBlock Text="设置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrC1}"/>
          </StackPanel>
          <StackPanel x:Name="PageTools" Visibility="Collapsed" Margin="20">
            <TextBlock Text="工具" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource BrC1}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>

<Window x:Class="UMango.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UMango.App.Views"
        Title="UMango" Height="620" Width="960" MinHeight="470" MinWidth="810"
        Background="{DynamicResource BrBg}"
        FontFamily="{DynamicResource UiFont}"
        WindowStartupLocation="CenterScreen">
  <!-- 任务栏进度：Windows 上任务栏图标显示下载/安装的总体进度。
       不写 Description 等可选属性；ProgressState/ProgressValue 由 TaskbarProgressBridge 写。 -->
  <Window.TaskbarItemInfo>
    <TaskbarItemInfo x:Name="WindowTaskbar" ProgressState="None" ProgressValue="0"/>
  </Window.TaskbarItemInfo>
  <!--
    窗口外壳：沿用 PCL-CE 的结构
      · 四周 10px 留白 + 6px 圆角的卡片式窗口
      · 顶部 48px 标题栏：左 Logo / 中 五个 banner 选项卡 / 右 三大金刚键
      · 标题栏下方：左栏菜单（随选项卡变化）+ 内容区（五个页面）
    三大金刚键使用 Windows 原生字形与行为（WPF 即 Windows 原生栈）。

    ⚠ 颜色/尺寸 token 一律 {DynamicResource}（不要退回 {StaticResource}）：
      StaticResource 在 XAML 加载时只求值一次，运行时 ThemeManager 换掉
      MergedDictionaries 里的 token 字典后不会重新求值，界面就"切不动主题"。
      唯一保留 StaticResource 的是样式/模板 key（BannerTab / CaptionButton / 本文件的
      NavItemStyle / NavItemTemplate）：它们本身不是主题资源，内部引用颜色时仍是 DynamicResource。
  -->
  <WindowChrome.WindowChrome>
    <!-- CaptionHeight 只能写常量：WindowChrome 不是 FrameworkElement，不在资源查找链里，
         拿不到 {DynamicResource TitleBarHeight}。数值与 token TitleBarHeight(48) 保持一致，改 token 时要一起改。 -->
    <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!--
      左栏菜单项渲染：**两行** —— 标题（13 号 BrC1）+ 可选副标题（11 号 BrG3）。
      副标题是为「包源分类」预留的同一套渲染：那里 Title = 包管理器名、Subtitle = 安装目录
      （需求原文要求左栏显示安装目录），普通菜单项只有标题。
      副标题为 null / 空字符串时用 DataTrigger 整块收起来：TextBlock 即使文本为空仍然占着
      Margin(0,2,0,0)，不收起来每项都会多出 2px 的假空隙。
      放在 Window.Resources 而不是 Themes/：这是外壳专属的渲染，页面不共用（Themes/ 归主题 agent）。
    -->
    <DataTemplate x:Key="NavItemTemplate">
      <StackPanel>
        <TextBlock Text="{Binding Title}" FontSize="13"
                   Foreground="{DynamicResource BrC1}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,2,0,0"
                   Foreground="{DynamicResource BrG3}" TextTrimming="CharacterEllipsis">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding Subtitle}" Value="{x:Null}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Subtitle}" Value="">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </DataTemplate>

    <!--
      左栏菜单项容器：**整块替换 ControlTemplate**（= 关闭默认选中高亮）。
      默认 ListBoxItem 的选中态是系统主题色蓝底，既不属于我们的 token 体系、
      深色主题下也不跟随，所以自绘：选中 = BrC6 底 + 左侧 3px BrC3 竖条（需求指定）。
      高度取 ListItemHeight(36)；带副标题的项由内容撑高，故用 MinHeight 而不是固定 Height。
    -->
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <!-- 关掉键盘焦点虚线框：它是系统绘制的、不跟主题走，而且 PCL 的左栏里没有这个视觉 -->
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Background="Transparent" MinHeight="{DynamicResource ListItemHeight}">
              <Border x:Name="Bd" Background="Transparent"/>
              <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Visibility="Collapsed"
                      Background="{DynamicResource BrC3}"/>
              <!-- 左内边距 16 留出竖条位置：竖条宽 3px 压在 16px 里，文字不会被它压住 -->
              <ContentPresenter Margin="16,6,10,6" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrG8}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrC6}"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!--
    ⚠ 不要在这里加 Margin（真机截图逐像素实测的缺陷）：
    原先 Margin="10" + DropShadowEffect(BlurRadius=12) 的卡片式外壳，
    需要的投影空间比窗口多出的边距更大，投影被窗口边缘裁断，
    露出的那圈窗口底色就成了"内容之外多出来的背景板"（实测右缘 16px 的 #F0F0F0 带）。
    PCL-CE 的做法是**根本没有这层外壳**：窗口不画背景板（Background 内容直接铺满），
    首次修正是照它的做法让 DWM 提供圆角；但用户明确要求
    **用 Windows 自身的窗口边界设定、不要自造圆角**，因此这里全部归零：
    WindowChrome.CornerRadius=0、卡片不再圆角、也不再需要圆角裁剪。
    窗口边界完全交回 Windows（是否圆角由系统决定，不由应用决定）。
  -->
  <Border x:Name="RootCard" Background="{DynamicResource BrCard}" SnapsToDevicePixels="True">

    <!-- UseLayoutRounding 采纳自 PCL-CE FormMain.xaml:28：让小字号文字与 1px 边线
         对齐设备像素，深色模式下小字（11-13px）的模糊/发虚明显改善。 -->
    <Grid UseLayoutRounding="True">
      <Grid.RowDefinitions>
        <!-- 标题栏用 Auto + 内部 Grid 的 Height=token：RowDefinition.Height 是 GridLength，
             喂给它一个 sys:Double 的 token 会被类型转换拒掉，所以高度挂在 Grid 上。 -->
        <RowDefinition Height="Auto"/>
        <!-- 副标题栏：Collapsed 时不占高度（Auto 行为），出现时占 34px -->
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== 标题栏 ===== -->
      <Grid Grid.Row="0" Height="{DynamicResource TitleBarHeight}"
            Background="{DynamicResource BrTitleBar}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 左：Logo + 应用名（自绘，不使用 PCL 图片资源） -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6"
                  Background="{DynamicResource BrTitleBarHover}">
            <TextBlock Text="🥭" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="UMango" Foreground="{DynamicResource BrTitleBarForeHot}" FontSize="15"
                     FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!--
          中：五个 banner 选项卡 —— 主页 / 下载 / 进度 / 设置 / 工具。
          「进度」是独立入口（需求要求下载进度页可直达），不再挂在下载页里。
          Tag 保持字符串形式（与改造前一致）：由一个 switch 映射到 ViewModels.AppTab，
          这样样式与命令机制都不变，将来加"外部跳转入口"也只是多一个 Tag。
          WindowChrome.IsHitTestVisibleInChrome 必须开：标题栏整条都是窗口 caption 区，
          不声明的话鼠标消息被当作"拖动窗口"吃掉，选项卡点不动。
        -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <RadioButton x:Name="TabHome" Content="{DynamicResource Nav.Home}" Style="{StaticResource BannerTab}"
                       IsChecked="True" Checked="Tab_Checked" Tag="home"/>
          <RadioButton x:Name="TabDownload" Content="{DynamicResource Nav.Download}" Style="{StaticResource BannerTab}"
                       Checked="Tab_Checked" Tag="download"/>
          <RadioButton x:Name="TabProgress" Content="{DynamicResource Nav.Progress}" Style="{StaticResource BannerTab}"
                       Checked="Tab_Checked" Tag="progress"/>
          <RadioButton x:Name="TabSettings" Content="{DynamicResource Nav.Settings}" Style="{StaticResource BannerTab}"
                       Checked="Tab_Checked" Tag="settings"/>
          <RadioButton x:Name="TabTools" Content="{DynamicResource Nav.Tools}" Style="{StaticResource BannerTab}"
                       Checked="Tab_Checked" Tag="tools"/>
        </StackPanel>

        <!-- 右：三大金刚键（Windows 原生风格：46x32、hover 高亮、关闭为红） -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
          <Button x:Name="BtnMin" Content="&#xE949;" Style="{StaticResource CaptionButton}"
                  Click="BtnMin_Click" ToolTip="{DynamicResource Window.Minimize}"/>
          <Button x:Name="BtnMax" Content="&#xE739;" Style="{StaticResource CaptionButton}"
                  Click="BtnMax_Click" ToolTip="{DynamicResource Window.Maximize}"/>
          <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource CaptionButtonClose}"
                  Click="BtnClose_Click" ToolTip="{DynamicResource Window.Close}"/>
        </StackPanel>
      </Grid>

      <!--
        ===== 副标题栏（次级页面时才出现）=====
        对应 PCL-CE 的「副页面标题」机制（FormMain.xaml.cs:1476-1505）：
        进入次级页面时在标题栏下方显示一行「← 返回  页面标题」，
        点标题或点返回都能退回上一层。

        默认 Visibility=Collapsed —— 主页面不显示这行，避免内容区被压掉 32px。
        可见性由 NavigationHost.IsSecondary 驱动。
      -->
      <!-- Grid 没有 BorderBrush/BorderThickness，所以外面套一层 Border 画下边线 -->
      <Border x:Name="SubTitleBar" Grid.Row="1" Height="34"
              Visibility="Collapsed"
              Background="{DynamicResource BrTitleBar}"
              BorderBrush="{DynamicResource BrG6}" BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Button x:Name="BtnBack" Content="&#xE72B;" Style="{StaticResource CaptionButton}"
                  Click="BtnBack_Click" ToolTip="{DynamicResource Window.Back}"
                  Width="28" Height="24" FontSize="12" Margin="0,0,6,0"/>
          <TextBlock x:Name="SubTitleText" Text="" FontSize="13"
                     Foreground="{DynamicResource BrC1}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>

      <!-- ===== 主体：左栏 + 内容区 ===== -->
      <Grid Grid.Row="2" x:Name="BodyGrid">
        <Grid.ColumnDefinitions>
          <!-- Auto + Border.Width=token：理由同标题栏（GridLength 不吃 Double token） -->
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--
          左栏：内容由 ShellViewModel.LeftMenu 驱动（每个选项卡一组菜单项），
          选中项 → ViewModel 的 CurrentNavKey（由 MainWindow.xaml.cs 接线）。
          ListBox 模板内自带 ScrollViewer，条目超出高度会自动出现滚动条，
          所以不再外套一层 ScrollViewer（否则会出现双层滚动条）。
        -->
        <Border Grid.Column="0" Width="{DynamicResource LeftRailWidth}"
                Background="{DynamicResource BrC8}"
                BorderBrush="{DynamicResource BrG6}" BorderThickness="0,0,1,0">
          <ListBox x:Name="LeftMenuList" Margin="0,8,0,0"
                   Background="Transparent" BorderThickness="0"
                   FocusVisualStyle="{x:Null}"
                   ItemTemplate="{StaticResource NavItemTemplate}"
                   ItemContainerStyle="{StaticResource NavItemStyle}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   SelectionChanged="LeftMenuList_SelectionChanged"/>
        </Border>

        <!--
          内容区：五个页面 UserControl **叠放在同一个 Grid 里，按可见性切换**。
          为什么不用 ContentControl 换内容：五个页面在 XAML 里各建一次，
          构造顺序可预测、Loaded（页面的异步加载入口）只触发一次；
          切页只改 Visibility，页面自己的滚动位置与展开状态都不会因为重建而丢失。
          内边距与滚动由各页面自己负责（页面根容器自带 Margin/ScrollViewer），
          外壳只提供区域与底色。
          底色取 BrBg（PCL 的窗口主体色）而不是 BrCard：卡片本身是 BrCard（白），
          页面（如进度页）刻意留透明等外壳给底色，底色若也是白就会"白卡片糊在白底上"没有层次。
        -->
        <Grid Grid.Column="1" Background="{DynamicResource BrBg}">
          <!--
            ===== 动态背景层 =====
            对应 PCL-CE 的 `Canvas x:Name="ImgBack"`（FormMain.xaml:112）：
            它挂在内容区的**最底层**，页面画在上面。
            PCL 的 ImgBack 是 Canvas（可放 MediaElement 视频），
            这里用 Border（要挂 ImageBrush 才有平铺/四角对齐）+ MediaElement 两层。
            页面本身的底色是透明的，所以背景能透出来；卡片（PclCard）仍是不透明的。
          -->
          <!-- 模糊半径（Border.Effect）由代码设置：BackgroundPresenter.ApplyAppearance -->
          <Border x:Name="BgImage" Visibility="Collapsed" IsHitTestVisible="False"/>
          <MediaElement x:Name="BgVideo" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                        Stretch="UniformToFill" Volume="0" IsHitTestVisible="False"
                        Visibility="Collapsed"/>
          <views:HomeView x:Name="ViewHome"/>
          <views:DownloadView x:Name="ViewDownload" Visibility="Collapsed"/>
          <views:ProgressView x:Name="ViewProgress" Visibility="Collapsed"/>
          <views:SettingsView x:Name="ViewSettings" Visibility="Collapsed"/>
          <views:ToolsView x:Name="ViewTools" Visibility="Collapsed"/>
          <!-- 下载器：工具页左栏选「下载器」时显示（见 MainWindow.xaml.cs 的 ApplyNavOverride） -->
          <views:DownloaderView x:Name="ViewDownloader" Visibility="Collapsed"/>
          <!-- 日志页：工具页左栏选「日志」时显示 -->
          <views:LogView x:Name="ViewLog" Visibility="Collapsed"/>
          <!-- 反馈页：工具页左栏选「反馈」时显示 -->
          <views:FeedbackView x:Name="ViewFeedback" Visibility="Collapsed"/>
          <!-- 音乐页：工具页左栏选「音乐」时显示 -->
          <views:MusicView x:Name="ViewMusic" Visibility="Collapsed"/>
        </Grid>
      </Grid>

      <!--
        ===== 全局提示浮层（PCL 的 PanHint 对应物）=====
        位置对齐 PCL-CE HintService：右下角，距底边 20px。
        内容由 PclUiBridge 汇入的 NotificationService 驱动（见 MainWindow.xaml.cs）。
        放在最外层 Grid 的最后一个子元素 → 浮在所有页面之上，且不参与布局测量。
      -->
      <ItemsControl x:Name="ToastHost" Grid.RowSpan="3"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,18,20" IsHitTestVisible="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!--
              提示条：左侧主题色条 + 文字；样式走主题 token，换主题即时生效。
              ⚠ 用 Grid 两列而不是横向 StackPanel：
              横向 StackPanel 给子元素**无限宽度**，TextWrapping 永远不会生效 ——
              长文案会把提示条撑到任意宽（被卡片裁掉一半，看起来像一截多余的横条）。
              Grid 的 * 列会把文字宽度约束在 MaxWidth 内，换行才会真正发生。
            -->
            <Border Background="{DynamicResource BrCard}"
                    BorderBrush="{DynamicResource BrG6}" BorderThickness="1"
                    CornerRadius="4" Padding="12,9" Margin="0,0,0,8" MaxWidth="360">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="3" CornerRadius="2" Margin="0,0,10,0"
                        Background="{Binding AccentBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap"
                           Style="{DynamicResource PclText}" VerticalAlignment="Center"/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Grid>
  </Border>
</Window>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    ============================================================================
    UMango 控件主题包：PCL 观感层（Avalonia 版）
    ============================================================================
    与 WPF 版 `src/UMango.App/Themes/Controls.Pcl.xaml` **同构**。

    【数值来源】PCL-CE 的 `Plain Craft Launcher 2/Application.xaml` 与
    `Controls/*.xaml`（实测提取，逐项对照）。**不含 PCL-CE 的任何 XAML 代码** ——
    只提取设计数值（颜色、尺寸、圆角、字号、内边距），模板与触发器全部自行实现。

    【PCL 的关键设计特征（实测数值）】
    · 圆角：按钮 3、输入框 3、列表项 3、复选框 2
    · 边框：1px，用 BrC1（#343d4a）而非灰色 —— 这是 PCL 的标志性观感
    · 按钮填充：BrHalfWhite（#55ffffff），叠在彩色底上呈半透明白
    · 文字：13px，Foreground = BrC1，TextTrimming = CharacterEllipsis
    · 列表项：高 36、内边距 8,4，选中时 BrC7 底色

    【与 WPF 版的差异（都是框架差异，不是设计差异）】
    ① WPF 的 ControlTemplate/Trigger → Avalonia 的 Style + Selector（`:pointerover` / `:pressed` / `:checked`）。
    ② WPF 的 `x:Key` 具名样式 → Avalonia 用 `Classes`（`Classes="pcl"`）——
       Avalonia 的样式**不能**像 WPF 那样用 `Style="{DynamicResource Xxx}"` 换掉控件模板，
       只能用 `Classes` 追加类名。两边因此在 XAML 上的写法不同，观感一致。
    ③ WPF 的 `DataTrigger`（按数据值变色）→ Avalonia 没有 DataTrigger，
       改用**绑定的 Brush**（见 LogView 的级别色）—— 语义等价。
    ④ WPF 的 `ToolTip.Placement` → Avalonia 的 `ToolTip.Placement`（枚举名不同，语义一致）。
  ============================================================================
  -->

  <!-- ==================== 通用：文字 ==================== -->
  <Style Selector="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
  </Style>

  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BrG3}" />
  </Style>

  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource BrG4}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
  </Style>

  <!-- 小节标题（WPF 的 PclSectionTitle） -->
  <Style Selector="TextBlock.section-title">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>

  <!--
    `pcl-` 前缀别名：与主页（HomeView）等早于本次移植的页面保持一致。
    两个壳里同一语义用同一组类名，避免"一半 pcl- 一半不带前缀"的混乱。
  -->
  <Style Selector="TextBlock.pcl-title">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
  </Style>

  <Style Selector="TextBlock.pcl-secondary">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BrG3}" />
  </Style>

  <Style Selector="TextBlock.pcl-hint">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource BrG4}" />
  </Style>

  <Style Selector="TextBlock.pcl-mono">
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- 等宽（终端输出 / 日志） -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Consolas, Menlo, monospace" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- ==================== 按钮 ==================== -->
  <Style Selector="Button.pcl">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="Background" Value="{DynamicResource BrHalfWhite}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrC1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.pcl:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrSemiWhite}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrC1}" />
  </Style>

  <Style Selector="Button.pcl:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrWhite}" />
  </Style>

  <Style Selector="Button.pcl:disabled /template/ ContentPresenter">
    <Setter Property="Opacity" Value="0.4" />
  </Style>

  <!-- 主操作按钮：强调色填充 + 白字（搜索/安装这类主动作） -->
  <Style Selector="Button.pcl-primary">
    <Setter Property="Background" Value="{DynamicResource BrC3}" />
    <Setter Property="Foreground" Value="{DynamicResource BrWhite}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrC3}" />
  </Style>

  <Style Selector="Button.pcl-primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrC2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrC2}" />
  </Style>

  <!-- 次要操作按钮（WPF 的 DownloadSecondaryButton）：白底深字 -->
  <Style Selector="Button.pcl-secondary">
    <Setter Property="Background" Value="{DynamicResource BrCard}" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrG6}" />
  </Style>

  <Style Selector="Button.pcl-secondary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrG8}" />
  </Style>

  <!-- 危险操作按钮（卸载/清空记录） -->
  <Style Selector="Button.pcl-danger">
    <Setter Property="Foreground" Value="{DynamicResource BrError}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrError}" />
  </Style>

  <!-- ==================== 输入框 ==================== -->
  <Style Selector="TextBox.pcl">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="CaretBrush" Value="{DynamicResource BrC1}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource BrC5}" />
    <Setter Property="Background" Value="{DynamicResource BrCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrG6}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style Selector="TextBox.pcl:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource BrC3}" />
  </Style>

  <Style Selector="TextBox.pcl:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BrG8}" />
  </Style>

  <!-- ==================== 复选框 ==================== -->
  <Style Selector="CheckBox.pcl">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
  </Style>

  <Style Selector="CheckBox.pcl /template/ Border#PART_BorderElement">
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrC1}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BrSemiTransparent}" />
  </Style>

  <Style Selector="CheckBox.pcl:checked /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource BrC3}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrC3}" />
  </Style>

  <Style Selector="CheckBox.pcl:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource BrC3}" />
  </Style>

  <!-- ==================== 下拉框 ==================== -->
  <Style Selector="ComboBox.pcl">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="Background" Value="{DynamicResource BrCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrG6}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="6,3" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <Style Selector="ComboBox.pcl:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource BrC3}" />
  </Style>

  <!-- 下拉项：hover 用 C6（浅蓝）、选中用 C7 -->
  <Style Selector="ComboBoxItem.pcl">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="ComboBoxItem.pcl:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrC6}" />
  </Style>

  <Style Selector="ComboBoxItem.pcl:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrC7}" />
  </Style>

  <!-- ==================== 列表项 ==================== -->
  <Style Selector="ListBoxItem.pcl">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ListBoxItem.pcl:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrG8}" />
  </Style>

  <Style Selector="ListBoxItem.pcl:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrC7}" />
  </Style>

  <!-- 列表本体：透明底、无边框（PCL 的列表不画边框） -->
  <Style Selector="ListBox.pcl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ==================== 滚动条 ==================== -->
  <Style Selector="ScrollBar.pcl">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="8" />
    <Setter Property="MinWidth" Value="8" />
  </Style>

  <Style Selector="ScrollBar.pcl:horizontal">
    <Setter Property="Height" Value="8" />
    <Setter Property="MinHeight" Value="8" />
  </Style>

  <Style Selector="ScrollBar.pcl /template/ Thumb#PART_Thumb">
    <Setter Property="Background" Value="{DynamicResource BrG5}" />
  </Style>

  <Style Selector="ScrollBar.pcl:pointerover /template/ Thumb#PART_Thumb">
    <Setter Property="Background" Value="{DynamicResource BrC4}" />
  </Style>

  <!-- ==================== 进度条 ==================== -->
  <Style Selector="ProgressBar.pcl">
    <Setter Property="Height" Value="4" />
    <Setter Property="Background" Value="{DynamicResource BrG6}" />
    <Setter Property="Foreground" Value="{DynamicResource BrC3}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="4" />
  </Style>

  <!-- ==================== 滑块 ==================== -->
  <Style Selector="Slider.pcl">
    <Setter Property="Foreground" Value="{DynamicResource BrC3}" />
    <Setter Property="Background" Value="{DynamicResource BrG6}" />
    <Setter Property="Height" Value="20" />
  </Style>

  <!-- ==================== 开关 ==================== -->
  <Style Selector="ToggleSwitch.pcl">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
  </Style>

  <!-- ==================== 卡片 ==================== -->
  <Style Selector="Border.pcl-card">
    <Setter Property="Background" Value="{DynamicResource BrCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrG6}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="12,10" />
  </Style>

  <!-- ==================== 顶部 banner 选项卡 ==================== -->
  <Style Selector="Button.banner">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource BrTitleBarFore}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="Button.banner:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrTitleBarHover}" />
  </Style>

  <Style Selector="Button.banner.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrTitleBarBar}" />
  </Style>

  <!-- ==================== 副标题栏的返回键 ==================== -->
  <Style Selector="Button.caption">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource BrTitleBarFore}" />
  </Style>

  <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrTitleBarHover}" />
  </Style>

  <!-- ==================== 工具提示 ==================== -->
  <Style Selector="ToolTip.pcl">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource BrC1}" />
    <Setter Property="Background" Value="{DynamicResource BrToolTip}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrG6}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="MaxWidth" Value="360" />
  </Style>
</Styles>

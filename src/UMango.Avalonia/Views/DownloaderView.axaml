<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:UMango.Avalonia.Converters"
             x:Class="UMango.Avalonia.Views.DownloaderView">
  <!--
    ============================================================================
    下载器页（Avalonia 版）
    ============================================================================
    与 WPF 版 `src/UMango.App/Views/DownloaderView.xaml`（201 行）**同构**。

    对应 PCL-CE 的「百宝箱」下载功能 —— 需求：弃用 PCL2 网页下载代码，
    重新集成 aria2 / bittorrent / ed2k（注意开源许可）。

    本页刻意体现三件事：
      1. **协议自动识别**：粘贴链接后就告诉用户识别成什么协议、交给哪个引擎；
      2. **许可说明直接摆出来**：每个引擎的 LicenseNote 可见（GPL 工具的
         「不链接也不分发」必须让用户看到）；
      3. **拿不到进度就不显示假百分比**：不确定态进度条 + 「已下载 X MiB」文案。

    框架差异：
      · WPF 的 `Style="{DynamicResource PclCard}"` → Avalonia 的 `Classes="pcl-card"`；
      · WPF 的 DataTrigger（引擎可用 → 绿点）→ Avalonia 用 IsAvailable 绑画刷；
      · WPF 的 `StringFormat` → Avalonia 用 JoinToTextConverter / 自定义绑定。
  ============================================================================
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                Padding="20,16,20,20" Background="Transparent">
    <StackPanel MaxWidth="880" HorizontalAlignment="Stretch">

      <!-- ===================== 1) 下载任务卡 ===================== -->
      <Border Classes="pcl-card" Padding="16,14">
        <StackPanel>
          <TextBlock Text="{DynamicResource Downloader.Title}" Classes="pcl-section-title"/>

          <!-- 链接输入 -->
          <TextBox x:Name="UrlBox" Margin="0,12,0,0" Padding="8,6"
                   Text="{Binding Url}"
                   Background="{DynamicResource BrCard}"
                   Foreground="{DynamicResource BrC1}"
                   BorderBrush="{DynamicResource BrG6}"/>

          <!-- 协议与引擎提示（随输入实时变化） -->
          <TextBlock Text="{Binding ProtocolHint}" Margin="0,6,0,0" FontSize="12"
                     Foreground="{DynamicResource BrG3}" TextWrapping="Wrap"/>

          <!-- 输出目录 -->
          <TextBlock Text="{DynamicResource Downloader.SaveTo}" Margin="0,12,0,4" FontSize="12"
                     Foreground="{DynamicResource BrG3}"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Padding="8,6"
                     Text="{Binding OutputDirectory}"
                     Background="{DynamicResource BrCard}"
                     Foreground="{DynamicResource BrC1}"
                     BorderBrush="{DynamicResource BrG6}"/>
            <!-- 浏览按钮在 code-behind 里调系统文件夹选择对话框：
                 文件对话框是 UI 框架类型，不能放进 ViewModel（否则 macOS 上无法单测）。 -->
            <Button Grid.Column="1" Margin="6,0,0,0" Height="30" MinWidth="72"
                    Content="{DynamicResource Downloader.Browse}"
                    Click="BrowseOutputDirectory_Click"/>
          </Grid>

          <!-- 操作按钮 -->
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Spacing="8">
            <Button Content="{DynamicResource Downloader.Start}" Width="96" Height="30"
                    Classes="pcl-primary"
                    Command="{Binding StartCommand}"/>
            <Button Content="{DynamicResource Downloader.Cancel}" Width="72" Height="30"
                    Classes="pcl"
                    Command="{Binding CancelCommand}"/>
            <Button Content="{DynamicResource Downloader.ClearOutput}" Width="96" Height="30"
                    Classes="pcl"
                    Command="{Binding ClearTerminalCommand}"/>
          </StackPanel>

          <!-- 进度：不确定态用 IsIndeterminate，不显示假百分比 -->
          <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                       Value="{Binding ProgressFraction, Converter={x:Static conv:NullableDoubleConverter.Instance}}"
                       IsIndeterminate="{Binding IsProgressKnown, Converter={x:Static conv:InverseBoolConverter.Instance}}"
                       Foreground="{DynamicResource BrC3}"
                       Background="{DynamicResource BrG6}" BorderThickness="0"/>

          <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                       Foreground="{DynamicResource BrC1}"/>
            <TextBlock Text="{Binding SpeedText}" FontSize="12"
                       Foreground="{DynamicResource BrG3}"/>
            <TextBlock Text="{Binding EtaText}" FontSize="12"
                       Foreground="{DynamicResource BrG3}"/>
          </StackPanel>

          <!-- 成功落盘路径 -->
          <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     IsVisible="{Binding SavedPath, Converter={x:Static conv:NotEmptyToBoolConverter.Instance}}"
                     Text="{Binding SavedPath}"/>

          <!-- 错误条 -->
          <Border Margin="0,10,0,0" Padding="10,8" CornerRadius="4"
                  Background="{DynamicResource BrRedBack}"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static conv:NotEmptyToBoolConverter.Instance}}">
            <TextBlock Text="{Binding ErrorMessage}" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource BrRed}"/>
          </Border>
        </StackPanel>
      </Border>

      <!-- ===================== 2) 下载引擎卡 ===================== -->
      <Border Classes="pcl-card" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="{DynamicResource Downloader.Engine}" Classes="pcl-section-title"/>
          <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG3}"
                     Text="{DynamicResource Downloader.EngineHint}"/>
          <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding Engines}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="4"
                        Background="{DynamicResource BrG8}"
                        BorderBrush="{DynamicResource BrG6}" BorderThickness="1">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <!-- 可用 = 主题蓝，不可用 = 红（WPF 侧用 DataTrigger，这里用绑画刷） -->
                      <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                               Fill="{Binding IsAvailable, Converter={x:Static conv:AvailableDotConverter.Instance}}" />
                      <TextBlock Text="{Binding DisplayName}" Margin="8,0,0,0"
                                 FontSize="13" FontWeight="SemiBold"
                                 Foreground="{DynamicResource BrC1}"/>
                      <TextBlock Text="{Binding ProtocolsText}" Margin="10,0,0,0"
                                 FontSize="11" VerticalAlignment="Center"
                                 Foreground="{DynamicResource BrG3}"/>
                    </StackPanel>
                    <!-- 许可说明：GPL 工具的"不链接也不分发"必须让用户看到 -->
                    <TextBlock Text="{Binding LicenseNote}" Margin="16,4,0,0"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrG4}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ===================== 3) 终端输出卡（非黑底！）===================== -->
      <Border Classes="pcl-card" Padding="16,14" Margin="0,12,0,0">
        <StackPanel>
          <TextBlock Text="{DynamicResource Downloader.TerminalOutput}" Classes="pcl-section-title"/>
          <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource BrG4}"
                     Text="{DynamicResource Downloader.TerminalHint}"/>
          <!-- 固定高度 + 自身滚动：输出可能很长，不能把页面撑开 -->
          <ScrollViewer Height="220" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto"
                        Background="{DynamicResource BrG8}">
            <ItemsControl ItemsSource="{Binding TerminalLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Grid 两列而非横向 StackPanel：横向 StackPanel 给子元素无限宽度，
                       TextWrapping 永不生效，长输出行会把容器横向撑爆（实测过的界面缺陷）。 -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding At, Converter={x:Static conv:TimeToStringConverter.Instance}}"
                               FontSize="11" Classes="mono" Margin="6,1,8,1"
                               Foreground="{DynamicResource BrG4}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11" TextWrapping="Wrap"
                               Classes="mono" Margin="0,1,6,1"
                               Foreground="{Binding IsStdErr, Converter={x:Static conv:StdErrBrushConverter.Instance}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>

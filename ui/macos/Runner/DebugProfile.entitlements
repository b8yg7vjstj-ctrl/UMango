<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  刻意关闭 App Sandbox。

	  UMango 是"图形化驱动命令行包管理器"的工具，必须：
	    · 执行 npm / pnpm / git / brew 等外部 CLI；
	    · 让这些 CLI 写入 ~/.npm、/opt/homebrew、用户项目目录等沙箱外位置；
	    · 读取用户的项目文件与全局配置。
	  沙箱内这些操作会被系统拒绝，包管理功能直接不可用。
	  代价是**无法上架 Mac App Store**，对这类开发者工具是可接受的取舍。
	  详见 docs/ARCHITECTURE.md「平台集成」一节。
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>

	<!-- 调试构建需要 JIT 与 VM Service 端口 -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- 访问包源 API（npm 下载量 / GitHub Stars / formulae.brew.sh） -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- 允许加载随应用分发的 libumango_bridge.dylib -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>

# ---- 构建产物（全部在 OneDrive 同步目录之外或应予忽略） ----
/build/
/ui/build/
/ui/.dart_tool/
/ui/.flutter-plugins
/ui/.flutter-plugins-dependencies
/ui/macos/Flutter/ephemeral/
/ui/macos/Pods/
/ui/macos/Podfile.lock
/core/target/
/native/build/
/native/cmake-build*/

# ---- 编辑器 / 系统 ----
.DS_Store
.idea/
.vscode/
*.iml
*.swp

# ---- 本地覆盖 ----
local.properties
*.local

# ---- .NET / WPF ----
# 注意用 **/ 而不是 src/**/：tools/ 下的工具工程同样会产出 bin/obj，
# 只写 src/** 时它们会被 git add -A 一起提交进去（真实发生过：误提交了 54 个
# 构建产物文件，包括几 MB 的 Roslyn DLL）。
**/bin/
**/obj/
*.user
*.suo
.vs/

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    本地化占位符元数静态审计工具。

    刻意用 net10.0 且**不引用任何 UI 框架**：它要在 macOS 上直接跑。
    只做两件事：
      ① 读语言文件（.txt 真相源），查同一键在各语言间的占位符集合是否一致；
      ② 用 Roslyn 扫 C# 调用点，把「实参个数」与「模板需要的占位符个数」对上。

    这类缺陷编译期不报、单元测试也不报，只有真机跑到那一行才炸 ——
    曾经就把 Avalonia 壳炸成「启动即崩溃」。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UMango.Tools.LocalizationAudit</RootNamespace>
    <AssemblyName>localization-audit</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>

</Project>
